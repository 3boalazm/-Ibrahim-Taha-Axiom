# Environment template for Ibrahim Taha Axiom.
# Copy to `.env` for local use. Never commit real values.
# On Vercel, set the website variables in Project → Settings → Environment
# Variables (separately for Production, Preview and Development).

# --- Research data ingestion (scripts/ingestion), local only, all optional ---
# OpenAlex API key, if OpenAlex's current access policy requires one.
OPENALEX_API_KEY=
# Semantic Scholar API key (raises rate limits; requested from Semantic Scholar).
SEMANTIC_SCHOLAR_API_KEY=
# Contact address sent to Crossref/OpenAlex for their "polite pool".
# Leave empty to use the anonymous public pool.
INGEST_CONTACT_EMAIL=

# --- Website (site/, deployed on Vercel) ---
# Canonical production URL, e.g. https://example.com (domain pending, D-07a).
PUBLIC_SITE_URL=
# Contact form (provider pending, D-08). Secrets live only in Vercel env.
CONTACT_FORM_TO=
CONTACT_FORM_SECRET=
# Visitor analytics (provider pending, D-10). Leave empty to disable.
PUBLIC_ANALYTICS_ID=
# Site assistant (site/api/chat.mjs, D-20). The key is a secret: set it only in
# Vercel (Production and Preview) or a local .env, never in the code.
GEMINI_API_KEY=
# Optional: model (default gemini-2.5-flash) and extra allowed origins, comma-separated.
GEMINI_MODEL=
CHAT_ALLOWED_ORIGINS=
