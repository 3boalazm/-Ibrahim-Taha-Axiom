---
import '@fontsource-variable/fraunces/full.css';
// Only the subsets this site uses (Latin, Latin-ext, Arabic).
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-sans/latin-ext-400.css';
import '@fontsource/ibm-plex-sans/latin-ext-500.css';
import '@fontsource/ibm-plex-sans/latin-ext-600.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-400.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-500.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-600.css';
import '@fontsource-variable/noto-kufi-arabic/wght.css';
import '@fontsource-variable/noto-naskh-arabic/index.css';
import '../styles/global.css';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SearchDialog from '../components/search/SearchDialog.astro';
import ChatWidget from '../components/chat/ChatWidget.astro';
import Seo from '../components/layout/Seo.astro';
// Validates every manifest relationship (both ends exist, quotes found verbatim) on each build.
import '../utils/relations';
import { dirOf } from '../utils/paths';
import { t } from '../i18n/ui';
import type { Lang } from '../utils/schema';

interface Props {
  lang: Lang;
  /** Locale-independent path, e.g. "/publications/". */
  path: string;
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  head?: { name: string; content: string }[];
  /** Pages without a translated twin (404) link the switcher here and skip canonical/hreflang. */
  switchPath?: string;
}
const { lang, path, title, description, ogType = 'website', jsonLd = [], head = [], switchPath } = Astro.props;
const navPath = switchPath ?? path;
const ui = t(lang);
---

<!doctype html>
<html lang={lang} dir={dirOf(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        // Marks that scripts run, so JS-only controls (e.g. the search button) can show.
        const root = document.documentElement;
        root.dataset.js = '';
        // Motion layer (docs/motion-system.md): starting states that hide anything apply
        // only under [data-motion], which needs JS and no reduced-motion preference. If the
        // motion module has not booted 2.5 s after load, drop the attribute so nothing stays hidden.
        if (window.matchMedia && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
          root.dataset.motion = '';
          try {
            // the brand mark draws itself once per browser session, not on every page
            if (!sessionStorage.getItem('axiom-mark')) {
              root.dataset.markIntro = '';
              sessionStorage.setItem('axiom-mark', '1');
            }
          } catch (_) {}
          addEventListener('load', () =>
            setTimeout(() => {
              if (!window.__axiomMotion) root.removeAttribute('data-motion');
            }, 2500),
          );
        }
        try {
          const s = localStorage.getItem('axiom-theme');
          if (s === 'light' || s === 'dark') document.documentElement.dataset.theme = s;
        } catch (_) {}
      })();
    </script>
    <Seo lang={lang} path={path} title={title} description={description} ogType={ogType} jsonLd={jsonLd} alternates={!switchPath} />
    {head.map((m) => <meta name={m.name} content={m.content} />)}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f7f4ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1512" media="(prefers-color-scheme: dark)" />
  </head>
  <body>
    <a class="skip-link" href="#main">{ui.skip}</a>
    <SiteHeader lang={lang} path={navPath} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter lang={lang} path={navPath} />
    <SearchDialog lang={lang} />
    <ChatWidget lang={lang} />
    <script>
      import { initMotion } from '../lib/motion.mjs';
      initMotion();
      // A language switch mirrors the whole layout; a cross-fade with sliding parts would
      // only confuse, so that one navigation skips the page transition.
      const isAr = (p: string) => p === '/ar' || p.startsWith('/ar/');
      window.addEventListener('pageswap', (e: Event) => {
        const ev = e as Event & { viewTransition?: { skipTransition(): void } | null; activation?: { entry?: { url?: string } } | null };
        const url = ev.activation?.entry?.url;
        if (!ev.viewTransition || !url) return;
        if (isAr(new URL(url).pathname) !== isAr(location.pathname)) ev.viewTransition.skipTransition();
      });
    </script>
  </body>
</html>
