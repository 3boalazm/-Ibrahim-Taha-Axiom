---
// Temporary "under construction" layout used only to verify the Vercel
// deployment pipeline (Astro build, Root Directory, EN/AR routing, RTL).
// It carries no researcher content and is not the final design.
interface Props {
  lang: 'en' | 'ar';
  message: string;
  switchLabel: string;
  switchHref: string;
}
const { lang, message, switchLabel, switchHref } = Astro.props;
const dir = lang === 'ar' ? 'rtl' : 'ltr';
const title = 'Ibrahim Taha Axiom';
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <link rel="alternate" hreflang="en" href="/" />
    <link rel="alternate" hreflang="ar" href="/ar/" />
    <link rel="alternate" hreflang="x-default" href="/" />
    <style>
      :root {
        --bg: #fbfbf9;
        --fg: #1b1d22;
        --muted: #5d636e;
        --line: #dcdcd6;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #121418;
          --fg: #ecedef;
          --muted: #a2a8b3;
          --line: #2c3038;
        }
      }
      html,
      body {
        margin: 0;
        min-height: 100%;
        background: var(--bg);
        color: var(--fg);
      }
      body {
        display: grid;
        place-items: center;
        min-height: 100vh;
        font-family: system-ui, 'Segoe UI', Tahoma, sans-serif;
        line-height: 1.6;
      }
      main {
        max-inline-size: 34rem;
        padding-inline: 1.5rem;
        text-align: start;
      }
      h1 {
        font-size: clamp(1.6rem, 4vw, 2.2rem);
        margin-block: 0 0.5rem;
        letter-spacing: -0.01em;
      }
      p {
        margin-block: 0 1.25rem;
        color: var(--muted);
      }
      a {
        color: inherit;
        text-underline-offset: 0.2em;
      }
      hr {
        border: 0;
        border-block-start: 1px solid var(--line);
        margin-block: 1.5rem;
      }
    </style>
  </head>
  <body>
    <main>
      <h1 dir="ltr">{title}</h1>
      <p>{message}</p>
      <hr />
      <a href={switchHref} hreflang={lang === 'en' ? 'ar' : 'en'}>{switchLabel}</a>
    </main>
  </body>
</html>
