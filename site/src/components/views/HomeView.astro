---
/**
 * Home page — a living research profile, kept light:
 *   hero (identity, positioning, a normal-density figure) → academic identity
 *   (progressive disclosure) → research discovery (compact area tiles, graph
 *   teaser) → selected publications (compact) → the lab → source-labelled
 *   metrics → the community → an invitation to write.
 * The full detail (area images and summaries, citations and abstracts,
 * projects) lives on each section's own page; the header and footer carry the
 * site's contents.
 * Every number on the page is derived from approved data at build time.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeHero from '../home/HomeHero.astro';
import IdentityPanel from '../home/IdentityPanel.astro';
import ResearchDiscovery from '../home/ResearchDiscovery.astro';
import LabTeaser from '../home/LabTeaser.astro';
import MetricCards from '../home/MetricCards.astro';
import CommunitySection from '../home/CommunitySection.astro';
import PublicationItem from '../publications/PublicationItem.astro';
import DraftNote from '../shared/DraftNote.astro';
import { SITE_NAME, pageCopy } from '../../config/site';
import { arDraft, profile, projects, researchAreas } from '../../utils/content';
import { publications, selectedPublications } from '../../utils/publications';
import { localePath } from '../../utils/paths';
import type { Lang } from '../../utils/schema';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = await pageCopy('home', lang);
const ar = lang === 'ar';

const contactPaths = ar
  ? [
      { id: 'collaboration', label: 'تعاون بحثي', note: 'ورقة أو مشروع أو بيانات مشتركة' },
      { id: 'consulting', label: 'استشارة إحصائية', note: 'تحليل بيانات أو مراجعة منهجية' },
      { id: 'supervision', label: 'إشراف أكاديمي', note: 'رسائل الماجستير والدكتوراه' },
      { id: 'speaking', label: 'محاضرة أو ورشة', note: 'المؤتمرات والتدريب' },
    ]
  : [
      { id: 'collaboration', label: 'Research collaboration', note: 'A joint paper, project or dataset' },
      { id: 'consulting', label: 'Statistical consulting', note: 'Data analysis or a methods review' },
      { id: 'supervision', label: 'Supervision', note: "Master's and doctoral work" },
      { id: 'speaking', label: 'Lectures and workshops', note: 'Conferences and training' },
    ];
// Arabic home shows unreviewed drafts (role, summary, area titles, the
// community's summary…) — say so once.
const community = projects.find((p) => p.id === 'statistical-analysis-egypt');
const usesDrafts =
  ar &&
  [profile.role, profile.summary, ...profile.interests, ...researchAreas.map((a) => a.title), community?.summary].some((v) => v && !v.ar && !!arDraft(v.en));
---

<BaseLayout lang={lang} path="/" title={SITE_NAME} description={copy.description}>
  <HomeHero lang={lang} lead={copy.lead} />
  {
    usesDrafts && (
      <div class="container home__draft">
        <DraftNote lang={lang} />
      </div>
    )
  }
  <IdentityPanel lang={lang} />
  <ResearchDiscovery lang={lang} />

  {
    selectedPublications.length > 0 && (
      <section class="home-works container" aria-labelledby="selected-heading">
        <div class="home-works__head" data-reveal>
          <div>
            <p class="kicker">{ar ? 'مختارات' : 'Selected'}</p>
            <h2 id="selected-heading" class="home-works__title">
              {ar ? 'منشورات مختارة' : 'Selected publications'}
            </h2>
          </div>
          <a class="button" href={localePath(lang, '/publications/')}>
            {ar ? 'كل المنشورات' : 'All publications'} <span class="ltr">({publications.length})</span>
          </a>
        </div>
        <div class="home-works__list" data-stagger>
          {selectedPublications.slice(0, 3).map((p) => (
            <PublicationItem pub={p} lang={lang} compact />
          ))}
        </div>
      </section>
    )
  }

  <LabTeaser lang={lang} />
  <MetricCards lang={lang} />

  <CommunitySection lang={lang} />

  <div class="container">
  <section class="home-cta" aria-labelledby="cta-heading" data-reveal>
    <div class="home-cta__copy">
      <p class="kicker">{ar ? 'تعاون' : 'Collaboration'}</p>
      <h2 id="cta-heading" class="home-cta__title">
        {ar ? 'هل لديك بياناتٌ تحتاج إلى قراءةٍ صحيحة؟' : 'Have data that deserves a fair reading?'}
      </h2>
      <p class="home-cta__lead">
        {ar ? 'اختر نوع الطلب لتبدأ رسالة قصيرة بالبريد الإلكتروني؛ لا يُرسَل شيء من الموقع نفسه.' : 'Pick the kind of request to start a short e-mail; nothing is sent from the site itself.'}
      </p>
    </div>
    <ul class="home-cta__paths" role="list">
      {
        contactPaths.map((p) => (
          <li>
            <a href={`${localePath(lang, '/contact/')}?path=${p.id}#composer`}>
              <span class="home-cta__path">{p.label}</span>
              <span class="home-cta__note">{p.note}</span>
              <span class="home-cta__arrow icon-flip" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
  </div>
</BaseLayout>

<style>
  .home__draft {
    padding-block-start: var(--space-5);
  }
  .home-works {
    display: grid;
    gap: var(--space-3);
    padding-block: clamp(var(--space-6), 5vw, var(--space-8));
  }
  .home-works__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .home-works__title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 400;
    line-height: 1.1;
  }
  .home-works__list {
    border-block-start: var(--border-hairline);
  }
  .home-cta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--space-6);
    align-items: center;
    margin-block-end: clamp(var(--space-6), 5vw, var(--space-8));
    padding: clamp(var(--space-5), 4vw, var(--space-7));
    background: var(--color-surface-1);
    border: var(--border-hairline);
    border-radius: var(--radius-4);
  }
  .home-cta__copy {
    display: grid;
    gap: var(--space-3);
  }
  .home-cta__title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 400;
    line-height: 1.1;
  }
  .home-cta__lead {
    color: var(--color-ink-2);
    line-height: 1.7;
  }
  .home-cta__paths {
    display: grid;
    border-block-start: var(--border-hairline);
  }
  .home-cta__paths a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'path arrow' 'note arrow';
    gap: 0.15rem var(--space-3);
    align-items: center;
    padding: var(--space-3) var(--space-1);
    border-block-end: var(--border-hairline);
    color: var(--color-ink);
    text-decoration: none;
  }
  .home-cta__path {
    grid-area: path;
    font-family: var(--font-serif);
    font-size: var(--step-1);
  }
  .home-cta__note {
    grid-area: note;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--color-ink-3);
  }
  .home-cta__arrow {
    grid-area: arrow;
    color: var(--color-accent);
    transition: transform var(--dur-2) var(--ease-out);
  }
  .home-cta__paths a:hover .home-cta__path {
    color: var(--color-accent);
  }
  .home-cta__paths a:hover .home-cta__arrow {
    transform: translateX(3px);
  }
  :global([dir='rtl']) .home-cta__paths a:hover .home-cta__arrow {
    transform: translateX(-3px) scaleX(-1);
  }
  .home-cta__paths a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  @media (max-width: 48rem) {
    .home-cta {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-cta__arrow {
      transition: none;
    }
  }
</style>
