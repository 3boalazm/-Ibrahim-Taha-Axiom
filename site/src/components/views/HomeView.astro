---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationItem from '../publications/PublicationItem.astro';
import LangText from '../shared/LangText.astro';
import { PRIMARY, SECTION_ORDER, SECTION_PATHS, SITE_NAME, pageCopy, sectionCount, sectionNumber } from '../../config/site';
import { manifest, profile } from '../../utils/content';
import { publications, selectedPublications } from '../../utils/publications';
import { localePath } from '../../utils/paths';
import { t } from '../../i18n/ui';
import type { Lang } from '../../utils/schema';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const copy = await pageCopy('home', lang);
const sections = await Promise.all(
  SECTION_ORDER.filter((k) => PRIMARY.includes(k) || (sectionCount(k) ?? 0) > 0).map(async (key) => {
    const c = await pageCopy(key, lang);
    const n = sectionCount(key);
    return { key, href: localePath(lang, SECTION_PATHS[key]), title: c.navLabel, lead: c.lead, n, number: sectionNumber(key) };
  }),
);
const recent = publications.filter((p) => !p.selected).slice(0, 3);
const pending = manifest.researcherApproval.status !== 'approved';
const words = SITE_NAME.split(' ');
const axiom = words.pop();
const hasIdentity = !!(profile.name.en || profile.name.ar || profile.role.en || profile.role.ar);
---

<BaseLayout lang={lang} path="/" title={SITE_NAME} description={copy.description}>
  <section class="masthead container">
    <div class="masthead__bar">
      <span class="label">{lang === 'ar' ? 'موقع أكاديمي' : 'Academic website'}</span>
      <span class="label masthead__langs"><span lang="en">English</span> / <span lang="ar">العربية</span></span>
    </div>
    <h1 class="masthead__title reveal" dir="ltr" lang="en">
      <span>{words.join(' ')}</span>
      <span class="masthead__axiom">{axiom}</span>
    </h1>
    {
      hasIdentity && (
        <p class="masthead__identity reveal reveal-2">
          <LangText value={profile.name} lang={lang} />
          {(profile.role.en || profile.role.ar) && <span> · </span>}
          <LangText value={profile.role} lang={lang} />
        </p>
      )
    }
    <p class="masthead__lead reveal reveal-2">
      {(profile.summary.en || profile.summary.ar) ? <LangText value={profile.summary} lang={lang} /> : copy.lead}
    </p>
    {
      pending && (
        <p class="masthead__notice reveal reveal-3" role="note">
          <span class="label">{ui.statusLabel}</span>
          <span>{ui.statusNotice}</span>
        </p>
      )
    }
  </section>

  {
    selectedPublications.length > 0 && (
      <section class="container home-block" aria-labelledby="selected-heading">
        <h2 id="selected-heading" class="home-block__title">{lang === 'ar' ? 'منشورات مختارة' : 'Selected publications'}</h2>
        {selectedPublications.slice(0, 4).map((p) => <PublicationItem pub={p} lang={lang} compact />)}
      </section>
    )
  }

  {
    recent.length > 0 && (
      <section class="container home-block" aria-labelledby="recent-heading">
        <h2 id="recent-heading" class="home-block__title">{lang === 'ar' ? 'أحدث الإسهامات' : 'Recent contributions'}</h2>
        {recent.map((p) => <PublicationItem pub={p} lang={lang} compact />)}
      </section>
    )
  }

  <section class="container contents" aria-labelledby="contents-heading">
    <h2 id="contents-heading" class="contents__title label">{ui.contents}</h2>
    <ol class="contents__list" role="list">
      {
        sections.map((s, i) => (
          <li class="reveal" style={`animation-delay:${80 + i * 40}ms`}>
            <a class="contents__row" href={s.href}>
              <span class="contents__num ltr">{s.number}</span>
              <span class="contents__text">
                <span class="contents__name">{s.title}</span>
                <span class="contents__lead">{s.lead}</span>
              </span>
              <span class="contents__status">{s.n && s.n > 0 ? ui.entries(s.n) : ui.awaitingReview}</span>
              <svg class="contents__arrow icon-flip" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h11m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<style>
  .masthead {
    padding-block: var(--space-7) var(--space-8);
  }
  .masthead__bar {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block-end: var(--space-3);
    border-block-end: 2px solid var(--color-ink);
  }
  .masthead__langs span[lang='ar'] {
    font-family: var(--font-ar-sans);
    letter-spacing: 0;
  }
  .masthead__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.35em;
    margin-block: var(--space-7) var(--space-5);
    font-family: var(--font-serif);
    font-size: var(--step-5);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.02;
  }
  :lang(ar) .masthead__title {
    font-family: var(--font-serif);
    font-weight: 600;
    letter-spacing: -0.025em;
    justify-content: flex-end;
  }
  .masthead__axiom {
    font-family: var(--font-sans);
    font-size: 0.32em;
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .masthead__identity {
    font-family: var(--font-ui);
    font-size: var(--step-1);
    color: var(--color-ink-2);
  }
  .masthead__lead {
    max-inline-size: 46ch;
    font-size: var(--step-2);
    line-height: 1.45;
    color: var(--color-ink-2);
  }
  :lang(ar) .masthead__lead {
    line-height: 1.75;
  }
  .masthead__notice {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    align-items: baseline;
    margin-block-start: var(--space-6);
    max-inline-size: 64ch;
    padding: var(--space-4) var(--space-5);
    background: var(--color-surface-1);
    border: var(--border-hairline);
    border-inline-start: 3px solid var(--color-accent);
    border-radius: var(--radius-2);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--color-ink-2);
  }
  .home-block {
    padding-block-end: var(--space-7);
  }
  .home-block__title {
    font-size: var(--step-2);
    padding-block-end: var(--space-3);
    border-block-end: var(--border-hairline);
  }
  .contents__title {
    display: block;
    padding-block-end: var(--space-3);
    border-block-end: var(--border-hairline);
  }
  .contents__list {
    padding: 0;
    list-style: none;
  }
  .contents__row {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) auto 1.25rem;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-5) var(--space-2);
    border-block-end: var(--border-hairline);
    color: inherit;
    text-decoration: none;
    transition: background var(--dur-2) var(--ease);
  }
  .contents__row:hover {
    background: var(--color-surface-1);
  }
  .contents__num {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-accent);
  }
  .contents__text {
    display: grid;
    gap: var(--space-1);
  }
  .contents__name {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.2;
  }
  .contents__lead {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--color-ink-2);
  }
  .contents__status {
    font-family: var(--font-ui);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-3);
    white-space: nowrap;
  }
  :lang(ar) .contents__status {
    text-transform: none;
    font-size: var(--step--1);
  }
  .contents__arrow {
    inline-size: 1.25rem;
    color: var(--color-ink-3);
    transition: transform var(--dur-2) var(--ease), color var(--dur-2) var(--ease);
  }
  .contents__row:hover .contents__arrow {
    color: var(--color-accent);
    transform: translateX(3px);
  }
  .contents__row:hover .contents__arrow:dir(rtl) {
    transform: scaleX(-1) translateX(3px);
  }
  @media (max-width: 40rem) {
    .contents__row {
      grid-template-columns: 2.5rem minmax(0, 1fr) 1rem;
    }
    .contents__status {
      grid-column: 2;
      grid-row: 2;
    }
    .contents__arrow {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
