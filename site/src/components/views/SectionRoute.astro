---
/**
 * One route component for every section page, in both languages.
 * Each section renders approved content, or an honest empty state.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../shared/PageHeader.astro';
import EmptyState from '../shared/EmptyState.astro';
import LangText from '../shared/LangText.astro';
import ProfileSummary from '../profile/ProfileSummary.astro';
import PublicationLibrary from '../publications/PublicationLibrary.astro';
import EntryList from '../research/EntryList.astro';
import { SECTION_PATHS, pageCopy, sectionCount, sectionNumber, type PageKey } from '../../config/site';
import { courses, cv, manifest, profile, projects, researchAreas, talks } from '../../utils/content';
import { books, getPublication, publications } from '../../utils/publications';
import { localePath } from '../../utils/paths';
import { t } from '../../i18n/ui';
import type { Lang } from '../../utils/schema';

interface Props {
  lang: Lang;
  page: Exclude<PageKey, 'home'>;
}
const { lang, page } = Astro.props;
const ui = t(lang);
const copy = await pageCopy(page, lang);
const count = sectionCount(page) ?? 0;
const crumbs = [{ label: ui.home, href: localePath(lang, '/') }, { label: copy.navLabel }];
const areaLabel = lang === 'ar' ? 'مجال بحثي' : 'Research area';
const projectLabel = lang === 'ar' ? 'مشروع' : 'Project';

// When a section's approved content exists only in English, the Arabic page shows it as
// one coherent English (LTR) block under a single note, instead of many mixed-direction
// fragments. Nothing is machine-translated.
const noAr = (v?: { ar: string | null } | null) => !v || !v.ar;
const englishOnly =
  lang === 'ar' &&
  count > 0 &&
  ((page === 'about' && noAr(profile.biography) && noAr(profile.summary) && noAr(profile.role)) ||
    (page === 'teaching' && courses.every((c) => noAr(c.title) && noAr(c.summary))) ||
    (page === 'cv' && !!cv && cv.sections.every((s) => s.items.every((i) => noAr(i.text)))));
const cl: Lang = englishOnly ? 'en' : lang;
// Publications linked to a talk through an approved, evidence-backed relationship.
const talkPapers = (id: string) =>
  manifest.relationships
    .filter((r) => r.to === `talk:${id}` && r.from.startsWith('publication:'))
    .map((r) => getPublication(r.from.slice('publication:'.length)))
    .filter((p) => p !== undefined);
const cui = t(cl);
const blockAttrs = englishOnly ? { lang: 'en', dir: 'ltr' } : {};
---

<BaseLayout lang={lang} path={SECTION_PATHS[page]} title={copy.title} description={copy.description}>
  <PageHeader lang={lang} title={copy.title} lead={copy.lead} number={sectionNumber(page)} crumbs={crumbs} />
  <div class="container section-body">
    {englishOnly && <p class="lang-note" role="note">{ui.sectionFallback}</p>}
    {
      page === 'about' &&
        (count > 0 ? (
          <div {...blockAttrs}>
            <ProfileSummary lang={cl} />
          </div>
        ) : (
          <EmptyState lang={lang} title={copy.emptyTitle} body={copy.emptyBody} />
        ))
    }
    {page === 'research' && (count > 0 ? <EntryList items={researchAreas} lang={lang} kind="area" badge={areaLabel} /> : <EmptyState lang={lang} title={copy.emptyTitle} body={copy.emptyBody} />)}
    {page === 'projects' && (count > 0 ? <EntryList items={projects} lang={lang} kind="project" badge={projectLabel} /> : <EmptyState lang={lang} title={copy.emptyTitle} body={copy.emptyBody} />)}
    {page === 'publications' && (count > 0 ? <PublicationLibrary pubs={publications} lang={lang} /> : <EmptyState lang={lang} title={copy.emptyTitle} body={copy.emptyBody} />)}
    {page === 'books' && (count > 0 ? <PublicationLibrary pubs={books} lang={lang} /> : <EmptyState lang={lang} title={copy.emptyTitle} body={copy.emptyBody} />)}
    {
      page === 'teaching' &&
        (count > 0 ? (
          <ol class="list" role="list" {...blockAttrs}>
            {courses.map((c) => (
              <li class="list__item">
                <h2>
                  <LangText value={c.title} lang={cl} />
                </h2>
                <p class="list__meta">
                  {c.institution && <LangText value={c.institution} lang={cl} />}
                  {c.term && <span class="ltr">{c.term}</span>}
                  {c.level && <LangText value={c.level} lang={cl} />}
                </p>
                <LangText value={c.summary} lang={cl} as="p" note />
                {c.materials.length > 0 && (
                  <ul class="list__links" role="list">
                    {c.materials.map((m) => (
                      <li>
                        <a href={m.url}>
                          <LangText value={m.label} lang={cl} />
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ol>
        ) : (
          <EmptyState lang={lang} title={copy.emptyTitle} body={copy.emptyBody} />
        ))
    }
    {
      page === 'talks' &&
        (count > 0 ? (
          <ol class="list" role="list">
            {talks.map((tk) => (
              <li class="list__item">
                <p class="list__date ltr">{tk.date}</p>
                <h2>
                  <LangText value={tk.title} lang={lang} />
                </h2>
                <p class="list__meta">
                  <LangText value={tk.event} lang={lang} />
                  {tk.location && <LangText value={tk.location} lang={lang} />}
                </p>
                <LangText value={tk.summary} lang={lang} as="p" note />
                {talkPapers(tk.id).map((p) => (
                  <p class="list__links">
                    <span class="label">{ui.relatedPaper}</span>
                    <a href={localePath(lang, `/publications/${p.key}/`)} lang={p.titleLang ?? undefined} dir="auto">
                      {p.title}
                    </a>
                  </p>
                ))}
                {tk.slides && (
                  <a href={tk.slides} class="button">
                    {ui.slides}
                  </a>
                )}
              </li>
            ))}
          </ol>
        ) : (
          <EmptyState lang={lang} title={copy.emptyTitle} body={copy.emptyBody} />
        ))
    }
    {
      page === 'cv' &&
        (count > 0 && cv ? (
          <div class="cv" {...blockAttrs}>
            {cv.pdf && (
              <p>
                <a class="button" href={cv.pdf}>
                  {cui.cvDownload}
                </a>
              </p>
            )}
            {cv.sections.map((s) => (
              <section class="cv__section">
                <h2>
                  <LangText value={s.heading} lang={cl} />
                </h2>
                <ul role="list">
                  {s.items.map((i) => (
                    <li>
                      {i.period && <span class="cv__period ltr">{i.period}</span>}
                      <LangText value={i.text} lang={cl} />
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        ) : (
          <EmptyState lang={lang} title={copy.emptyTitle} body={copy.emptyBody} />
        ))
    }
    {
      page === 'contact' && (
        <>
          {profile.contact.email || profile.contact.phone ? (
            <section class="contact-card" aria-labelledby="direct-contact">
              <h2 id="direct-contact" class="label">{ui.contactDirect}</h2>
              <dl>
                {profile.contact.email && (
                  <div>
                    <dt>{ui.email}</dt>
                    <dd>
                      <a class="ltr" href={`mailto:${profile.contact.email}`}>{profile.contact.email}</a>
                    </dd>
                  </div>
                )}
                {profile.contact.phone && (
                  <div>
                    <dt>{ui.phone}</dt>
                    <dd>
                      <a class="ltr" href={`tel:${profile.contact.phone.replace(/[\s-]/g, '')}`}>{profile.contact.phone}</a>
                    </dd>
                  </div>
                )}
              </dl>
            </section>
          ) : (
            <EmptyState lang={lang} title={copy.emptyTitle} body={copy.emptyBody} />
          )}
          {profile.identifiers.length > 0 && (
            <section class="contact-profiles">
              <h2 class="label">{ui.identifiers}</h2>
              <ul role="list">
                {profile.identifiers.map((i) => (
                  <li>
                    <a href={i.url} rel="me noopener">
                      {i.type}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}
          {profile.community.length > 0 && (
            <section class="contact-profiles">
              <h2 class="label">{ui.community}</h2>
              <ul role="list">
                {profile.community.map((c) => (
                  <li>
                    <a href={c.url} rel="noopener">
                      <LangText value={c.label} lang={lang} />
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </>
      )
    }
  </div>
</BaseLayout>

<style>
  .section-body {
    padding-block-start: var(--space-4);
  }
  .lang-note {
    margin-block-end: var(--space-5);
    padding: var(--space-3) var(--space-4);
    max-inline-size: var(--width-wide);
    background: var(--color-surface-1);
    border: var(--border-hairline);
    border-inline-start: 3px solid var(--color-accent);
    border-radius: var(--radius-2);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--color-ink-2);
  }
  .list {
    padding: 0;
    list-style: none;
    max-inline-size: var(--width-wide);
  }
  .list__item {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-5);
    border-block-end: var(--border-hairline);
  }
  .list__item h2 {
    font-size: var(--step-2);
  }
  .list__meta,
  .list__date {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--color-ink-3);
  }
  .list__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
    font-family: var(--font-ui);
    font-size: var(--step--1);
  }
  .cv__section {
    padding-block: var(--space-5);
    border-block-end: var(--border-hairline);
    max-inline-size: var(--width-wide);
  }
  .cv__section ul {
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-2);
    margin-block-start: var(--space-3);
  }
  .cv__period {
    display: inline-block;
    min-inline-size: 7rem;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--color-ink-3);
  }
  .contact-card {
    max-inline-size: var(--width-wide);
    padding: var(--space-6);
    background: var(--color-surface-1);
    border: var(--border-hairline);
    border-inline-start: 3px solid var(--color-accent);
    border-radius: var(--radius-2);
  }
  .contact-card dl {
    display: grid;
    gap: var(--space-4);
    margin-block-start: var(--space-4);
  }
  .contact-card dt {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--color-ink-3);
  }
  .contact-card dd {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--step-1);
  }
  .contact-profiles {
    margin-block-start: var(--space-6);
  }
  .contact-profiles ul {
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-block-start: var(--space-2);
  }
</style>
