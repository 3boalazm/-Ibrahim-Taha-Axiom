---
interface Props {
  kind: 'publication' | 'project' | 'teaching' | 'talk' | 'book';
  label: string;
}
const { kind, label } = Astro.props;
---

<span class="type-badge" style={`--badge: var(--type-${kind})`}>{label}</span>

<style>
  .type-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-family: var(--font-ui);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-2);
  }
  .type-badge::before {
    content: '';
    inline-size: 0.5em;
    block-size: 0.5em;
    border-radius: 50%;
    background: var(--badge);
  }
  .type-badge:lang(ar) {
    text-transform: none;
    font-size: var(--step--1);
  }
</style>
