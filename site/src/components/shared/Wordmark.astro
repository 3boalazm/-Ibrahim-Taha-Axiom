---
import Mark from './Mark.astro';
import { localePath } from '../../utils/paths';
import { SITE_NAME } from '../../config/site';
import type { Lang } from '../../utils/schema';

interface Props {
  lang: Lang;
  size?: 'sm' | 'lg';
}
const { lang, size = 'sm' } = Astro.props;
// The brand is written in Latin script in both languages and always reads LTR.
const words = SITE_NAME.split(' ').filter((w) => !/^axiom$/i.test(w));
const name = words.slice(-2).join(' ');
const axiom = SITE_NAME.split(' ').pop() ?? '';
---

<a class:list={['wordmark', `wordmark--${size}`]} href={localePath(lang, '/')} dir="ltr" lang="en" aria-label={SITE_NAME}>
  <Mark size={size === 'lg' ? '2.9em' : '2.5em'} class="wordmark__mark" />
  <span class="wordmark__text">
    <span class="wordmark__name">{name}</span>
    <span class="wordmark__axiom">{axiom}</span>
  </span>
</a>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .wordmark__mark {
    color: var(--color-accent);
  }
  :global(:root[data-theme='dark']) .wordmark__mark {
    color: var(--color-paper);
  }
  .wordmark__text {
    display: grid;
    gap: 0.1em;
  }
  .wordmark__name {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: var(--step-0);
    letter-spacing: -0.015em;
    line-height: 1.05;
  }
  .wordmark__axiom {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-brass);
    line-height: 1;
  }
  .wordmark:hover .wordmark__name {
    color: var(--color-accent-strong);
  }

  .wordmark--lg .wordmark__name {
    font-size: var(--step-2);
  }
  .wordmark--lg .wordmark__axiom {
    font-size: 0.7rem;
  }
</style>
