---
import { localePath } from '../../utils/paths';
import { SITE_NAME } from '../../config/site';
import type { Lang } from '../../utils/schema';

interface Props {
  lang: Lang;
  size?: 'sm' | 'lg';
}
const { lang, size = 'sm' } = Astro.props;
// The brand is written in Latin script in both languages and always reads LTR.
const words = SITE_NAME.split(' ').filter((w) => !/^axiom$/i.test(w));
const name = words.slice(-2).join(' ');
const initials = words
  .slice(-2)
  .map((w) => w[0])
  .join('');
const axiom = SITE_NAME.split(' ').pop() ?? '';
---

<a class:list={['wordmark', `wordmark--${size}`]} href={localePath(lang, '/')} dir="ltr" lang="en" aria-label={SITE_NAME}>
  <span class="wordmark__mark" aria-hidden="true">{initials}</span>
  <span class="wordmark__text">
    <span class="wordmark__name">{name}</span>
    <span class="wordmark__axiom">{axiom}</span>
  </span>
</a>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .wordmark__mark {
    display: grid;
    place-items: center;
    inline-size: 2.5em;
    block-size: 2.5em;
    border-radius: 50%;
    border: 1px solid var(--color-rule-strong);
    background: var(--color-accent);
    color: var(--color-paper);
    font-family: var(--font-serif);
    font-size: var(--step--1);
    font-weight: 500;
    font-variation-settings: 'SOFT' 40, 'WONK' 1;
    letter-spacing: 0.02em;
    line-height: 1;
    transition: transform var(--dur-2) var(--ease-out), background var(--dur-2) var(--ease);
  }
  .wordmark:hover .wordmark__mark {
    transform: rotate(-6deg);
    background: var(--color-accent-strong);
  }
  .wordmark__text {
    display: grid;
    gap: 0.1em;
  }
  .wordmark__name {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: var(--step-0);
    letter-spacing: -0.015em;
    line-height: 1.05;
  }
  .wordmark__axiom {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-brass);
    line-height: 1;
  }
  .wordmark:hover .wordmark__name {
    color: var(--color-accent-strong);
  }
  .wordmark--lg .wordmark__mark {
    inline-size: 2.9em;
    block-size: 2.9em;
    font-size: var(--step-0);
  }
  .wordmark--lg .wordmark__name {
    font-size: var(--step-2);
  }
  .wordmark--lg .wordmark__axiom {
    font-size: 0.7rem;
  }
</style>
