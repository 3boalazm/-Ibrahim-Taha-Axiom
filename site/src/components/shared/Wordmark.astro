---
import { localePath } from '../../utils/paths';
import { SITE_NAME } from '../../config/site';
import type { Lang } from '../../utils/schema';

interface Props {
  lang: Lang;
  size?: 'sm' | 'lg';
}
const { lang, size = 'sm' } = Astro.props;
// The brand is written in Latin script in both languages and always reads LTR.
const words = SITE_NAME.split(' ').filter((w) => !/^axiom$/i.test(w));
const name = words.slice(-2).join(' ');
const axiom = SITE_NAME.split(' ').pop() ?? '';
---

<a class:list={['wordmark', `wordmark--${size}`]} href={localePath(lang, '/')} dir="ltr" lang="en" aria-label={SITE_NAME}>
  <img
    class="wordmark__mark"
    src="/images/avatar.webp"
    srcset="/images/avatar.webp 160w, /images/avatar@2x.webp 320w"
    sizes="40px"
    width="160"
    height="160"
    alt=""
    decoding="async"
  />
  <span class="wordmark__text">
    <span class="wordmark__name">{name}</span>
    <span class="wordmark__axiom">{axiom}</span>
  </span>
</a>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .wordmark__mark {
    inline-size: 2.5em;
    block-size: 2.5em;
    border-radius: 50%;
    flex: none;
    object-fit: cover;
    box-shadow: 0 0 0 1px var(--color-rule-strong);
    transition: transform var(--dur-2) var(--ease-out), box-shadow var(--dur-2) var(--ease);
  }
  .wordmark:hover .wordmark__mark {
    transform: scale(1.05);
    box-shadow: 0 0 0 2px var(--color-brass);
  }
  .wordmark__text {
    display: grid;
    gap: 0.1em;
  }
  .wordmark__name {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: var(--step-0);
    letter-spacing: -0.015em;
    line-height: 1.05;
  }
  .wordmark__axiom {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-brass);
    line-height: 1;
  }
  .wordmark:hover .wordmark__name {
    color: var(--color-accent-strong);
  }
  .wordmark--lg .wordmark__mark {
    inline-size: 2.9em;
    block-size: 2.9em;
  }
  .wordmark--lg .wordmark__name {
    font-size: var(--step-2);
  }
  .wordmark--lg .wordmark__axiom {
    font-size: 0.7rem;
  }
</style>
