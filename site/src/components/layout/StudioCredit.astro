---
/**
 * Studio credit (site/README.md#studio-credit): a section of its own on every page, after
 * the page's content and right before the site footer (BaseLayout.astro). It says the
 * website was developed by Aboalazm OS Studio and links to the studio's website.
 *
 * It wears the studio's identity, not the site's. The values are the studio's design
 * tokens (its "semantic monochrome" system):
 * - the obsidian canvas #080710 (also the studio app's theme colour);
 * - one text colour at fixed opacities, and the 8 % white "spec line";
 * - the studio accent #F5A623, which that system keeps for focus rings and critical calls
 *   to action: here, the one button;
 * - the 24 px radius of its large panels;
 * - the studio's typefaces (Montserrat, JetBrains Mono for labels; IBM Plex Sans Arabic
 *   in Arabic) and its signature easing.
 * None of the site's colour, font, spacing or motion tokens are used
 * (tests/studio-credit.test.mjs).
 *
 * content-visibility: auto keeps the section, and so its two web fonts, from being laid
 * out until it nears the viewport. Until then the browser reserves the height computed by
 * contain-intrinsic-block-size, from the same values the layout uses (the --credit-*
 * values below), so the footer does not move when the section is laid out.
 */
import '@fontsource/montserrat/latin-700.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import { t } from '../../i18n/ui';
import type { Lang } from '../../utils/schema';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const STUDIO_URL = 'https://aboalazm-os.vercel.app/';
---

<section class="studio-credit" aria-labelledby="studio-credit-title" data-studio-credit data-pagefind-ignore>
  <div class="container">
    <div class="studio-credit__panel">
      <div>
        <h2 class="studio-credit__by" id="studio-credit-title">
          <span class="studio-credit__label">{ui.studioCreditLabel}</span>{' '}
          <span class="studio-credit__name"><bdi lang="en">Aboalazm OS Studio</bdi></span>
        </h2>
        <p class="studio-credit__meta">{ui.studioCreditMeta}</p>
      </div>
      <a class="studio-credit__cta" href={STUDIO_URL} target="_blank" rel="noopener">
        <span>{ui.studioCreditCta}</span>
        <svg class="icon-flip" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 17 17 7M8.5 7H17v8.5"></path></svg>
        <span class="visually-hidden">{` ${ui.studioCreditNewTab}`}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .studio-credit {
    /* Aboalazm OS design tokens: the studio's identity, not the site's */
    --os-obsidian: #080710;
    --os-line: rgb(255 255 255 / 0.08); /* the spec line */
    --os-text: rgb(248 248 250);
    --os-text-2: rgb(248 248 250 / 0.68);
    --os-accent: #f5a623;
    --os-accent-hover: #f7b84f; /* the accent with 20 % white */
    --os-radius-panel: 24px; /* the studio's large panels */
    --os-ease: cubic-bezier(0.16, 1, 0.3, 1); /* the studio's signature curve */
    --os-fast: 200ms;
    --os-sans: 'Montserrat', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --os-mono: 'JetBrains Mono', ui-monospace, 'SFMono-Regular', monospace;
    --os-arabic: 'IBM Plex Sans Arabic', system-ui, sans-serif;

    /* This section's own layout values (not tokens). Its height, before it is laid out, is
       computed from them: border, padding, label and meta lines, their margins, the name's
       lines, and, when stacked, the gap and the button under the text. */
    --credit-pad: clamp(1.75rem, 1rem + 3vw, 3rem);
    --credit-name-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem);
    --credit-label-line: 1.03125rem; /* 0.6875rem at line-height 1.5 */
    --credit-name-lines: 1;
    --credit-meta-lines: 1;
    --credit-below: 4.5rem; /* the 1.5rem gap and the 3rem button, when stacked */

    /* the page's content already ends with its own space, and the footer adds its margin below */
    margin-block-start: clamp(2.5rem, 1.5rem + 2.5vw, 4rem);
    content-visibility: auto;
    contain-intrinsic-block-size: auto
      calc(
        2px + 2 * var(--credit-pad) + (1 + var(--credit-meta-lines)) * var(--credit-label-line) + 1.2rem +
          1.1 * var(--credit-name-size) * var(--credit-name-lines) + var(--credit-below)
      );
  }
  .studio-credit:lang(ar) {
    --credit-label-line: 1.21875rem; /* 0.8125rem at line-height 1.5 */
  }
  /* The text and the button: stacked, then side by side from 48rem, where they fit with room
     to spare in both languages (a fixed point, so the reserved height above stays right). */
  .studio-credit__panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    padding: var(--credit-pad);
    border: 1px solid var(--os-line);
    border-radius: var(--os-radius-panel);
    background: var(--os-obsidian);
    color: var(--os-text);
    font-family: var(--os-sans);
  }
  /* a real heading for the section, without the site's heading styles */
  .studio-credit__by {
    margin: 0;
    font: inherit;
    letter-spacing: normal;
    color: inherit;
  }
  .studio-credit__label,
  .studio-credit__meta {
    font-family: var(--os-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--os-text-2);
  }
  .studio-credit__label {
    display: block;
  }
  .studio-credit__name {
    display: block;
    margin-block-start: 0.45rem;
    font-family: var(--os-sans);
    font-size: var(--credit-name-size);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--os-text);
  }
  /* the site gives Latin inside Arabic headings its serif (global.css); the studio's name keeps Montserrat */
  .studio-credit__name bdi {
    font-family: inherit;
  }
  .studio-credit__meta {
    margin: 0.75rem 0 0;
  }
  .studio-credit__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    min-block-size: 3rem;
    padding-inline: 1.4rem;
    border-radius: 999px;
    background: var(--os-accent);
    color: var(--os-obsidian);
    font-family: var(--os-sans);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    transition: background-color var(--os-fast) var(--os-ease);
  }
  .studio-credit__cta:hover {
    background: var(--os-accent-hover);
    color: var(--os-obsidian);
  }
  /* the studio's ring: amber, at once (not the site's closing-in focus animation, motion.css) */
  .studio-credit__cta:focus-visible {
    outline: 2px solid var(--os-accent);
    outline-offset: 3px;
    animation: none;
  }
  .studio-credit__cta svg {
    inline-size: 1.05rem;
    block-size: 1.05rem;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Arabic: the studio's Arabic face, without the tracking and capitals of its Latin labels
     (tracking breaks the joins of Arabic letters); 600 is the heaviest weight the site loads. */
  .studio-credit__label:lang(ar),
  .studio-credit__meta:lang(ar),
  .studio-credit__cta:lang(ar) {
    font-family: var(--os-arabic);
    letter-spacing: 0;
    text-transform: none;
  }
  .studio-credit__label:lang(ar),
  .studio-credit__meta:lang(ar) {
    font-size: 0.8125rem;
  }
  .studio-credit__cta:lang(ar) {
    font-weight: 600;
  }
  @media (max-width: 30rem) {
    .studio-credit__cta {
      inline-size: 100%;
      justify-content: center;
    }
  }
  /* Where the name (249.5 px wide on one line) and then the English label line (243 px)
     take two lines, measured with the studio's fonts: 344 px and 337 px wide viewports.
     The e2e tests check that the reserved height matches the laid-out one. */
  @media (max-width: 21.5rem) {
    .studio-credit {
      --credit-name-lines: 2;
    }
  }
  @media (max-width: 21.0625rem) {
    .studio-credit:lang(en) {
      --credit-meta-lines: 2;
    }
  }
  @media (min-width: 48rem) {
    .studio-credit {
      --credit-below: 0rem;
    }
    .studio-credit__panel {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 2.5rem;
    }
  }
</style>
