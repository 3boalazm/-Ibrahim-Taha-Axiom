---
import { arNoun } from '../../lib/text.mjs';
import Wordmark from '../shared/Wordmark.astro';
import { SECTION_PATHS, SITE_NAME, navKeys, pageCopy } from '../../config/site';
import { arDrafts, manifest, profile, researchAreas, showArDrafts } from '../../utils/content';
import { publications, selectedPublications } from '../../utils/publications';
import { localePath, otherLang } from '../../utils/paths';
import { t } from '../../i18n/ui';
import type { Lang } from '../../utils/schema';

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const ui = t(lang);
const items = await Promise.all(navKeys.map(async (key) => ({ href: localePath(lang, SECTION_PATHS[key]), label: (await pageCopy(key, lang)).navLabel })));
const year = new Date().getFullYear();
const target = otherLang(lang);
// Arabic translation status, counted from the drafts file (never claims a review).
const draftCount = arDrafts.entries.filter((e) => e.status !== 'reviewed').length;
const reviewedCount = arDrafts.entries.length - draftCount;
// One link per platform: the researcher has two Scopus ids, which would read as a duplicate.
const ids = profile.identifiers
  .filter((i) => ['ORCID', 'Google Scholar', 'Scopus', 'ResearchGate', 'LinkedIn', 'GitHub', 'OpenAlex'].includes(i.type))
  .filter((i, _n, all) => all.findIndex((x) => x.type === i.type) === _n)
  .map((i) => ({ ...i, type: i.type === 'Scopus' ? 'Scopus (2 ids)' : i.type }));
const headline =
  lang === 'ar'
    ? 'بحثٌ في الإحصاء التطبيقي والقياس الاقتصادي، يصنع أدواتٍ تُقاس.'
    : 'Applied statistics and econometrics, made usable.';
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="container site-footer__top">
    <p class="site-footer__headline">
      {headline}
    </p>
    <div class="site-footer__actions">
      <a class="button button--solid button--lg" href={localePath(lang, '/contact/')}>
        {lang === 'ar' ? 'ابدأ محادثة' : 'Start a conversation'}
        <span class="button__arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>

  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <Wordmark lang={lang} size="lg" />
      <p>{ui.footerNote}</p>
      {
        (profile.contact.email || profile.contact.phone) && (
          <ul class="site-footer__contact" role="list">
            {profile.contact.email && (
              <li>
                <a class="ltr" href={`mailto:${profile.contact.email}`}>{profile.contact.email}</a>
              </li>
            )}
            {profile.contact.phone && (
              <li>
                <a class="ltr" href={`tel:${profile.contact.phone.replace(/[\s-]/g, '')}`}>{profile.contact.phone}</a>
              </li>
            )}
          </ul>
        )
      }
    </div>

    <nav aria-label={ui.footerNav}>
      <h2 class="label">{ui.footerNav}</h2>
      <ul role="list">
        {items.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
      </ul>
    </nav>

    {
      researchAreas.length > 0 && (
        <div>
          <h2 class="label">{ui.interests}</h2>
          <ul role="list">
            {profile.interests.slice(0, 6).map((i) => (
              <li>{i.en ?? i.ar}</li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="site-footer__meta">
      <h2 class="label">{ui.identifiers}</h2>
      <ul role="list">
        {
          ids.map((i) => (
            <li>
              <a href={i.url} rel="me noopener">
                {i.type}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="site-footer__lang">
        <a href={localePath(target, path)} hreflang={target} lang={target}>{t(target).languageName}</a>
      </p>
      {
        manifest.researcherApproval.status !== 'approved' && (
          <p class="site-footer__status">
            <span class="label">{ui.statusLabel}</span> {ui.awaitingReview}
          </p>
        )
      }
    </div>
  </div>

  {
    lang === 'ar' && showArDrafts && (
      <div class="container site-footer__translation">
        <p>
          <span class="label">{ui.translationStatus}</span> {ui.draftFooter}{' '}
          <span>
            ({draftCount} نصًّا مبدئيًا بانتظار المراجعة{reviewedCount > 0 ? `، و${reviewedCount} نصًّا رُوجع` : ''}.)
          </span>
        </p>
      </div>
    )
  }
  <div class="container site-footer__bottom">
    <p class="site-footer__copy">
      <bdi dir="ltr">© {year} {SITE_NAME}</bdi>. {ui.rights}
    </p>
    <p class:list={['site-footer__counts', { ltr: lang !== 'ar' }]}>
      {publications.length}{' '}
      {lang === 'ar' ? arNoun(publications.length, { one: 'منشور', two: 'منشوران', few: 'منشورات', many: 'منشورًا' }) : 'publications'} ·{' '}
      {selectedPublications.length} {lang === 'ar' ? 'مختارة' : 'selected'} · {researchAreas.length}{' '}
      {lang === 'ar' ? arNoun(researchAreas.length, { one: 'مجال بحثي', two: 'مجالان بحثيان', few: 'مجالات بحثية', many: 'مجالًا بحثيًا' }) : 'research areas'}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--space-9);
    background: var(--color-invert-bg);
    color: var(--color-invert-fg);
    font-family: var(--font-ui);
    font-size: var(--step--1);
  }
  .site-footer__top {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block: clamp(var(--space-7), 6vw, var(--space-9)) var(--space-7);
    border-block-end: 1px solid color-mix(in srgb, var(--color-invert-fg) 16%, transparent);
  }
  .site-footer__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  /* The inverted panel inverts its solid button too: a paper pill on deep ink in
     both themes (the global solid button is ink, which vanished here in light mode). */
  .site-footer .button--solid {
    --btn-bg: var(--color-invert-fg);
    --btn-fg: var(--color-invert-bg);
    --btn-line: var(--color-invert-fg);
  }
  .site-footer .button--solid:hover {
    --btn-bg: var(--color-invert-brass);
    --btn-line: var(--color-invert-brass);
    color: var(--color-invert-bg);
  }
  .site-footer__copy,
  .site-footer__counts {
    margin: 0;
  }
  .site-footer__headline {
    max-inline-size: 22ch;
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: var(--tracking-display);
    color: inherit;
    text-wrap: balance;
  }
  :lang(ar) .site-footer__headline {
    font-family: var(--font-ar-display);
    line-height: 1.45;
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.7fr 1fr 1fr 1fr;
    gap: var(--space-6);
    padding-block: var(--space-7);
  }
  .site-footer__grid a {
    color: inherit;
    text-decoration: none;
    opacity: 0.82;
  }
  .site-footer__grid a:hover {
    opacity: 1;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .site-footer__grid .label {
    color: color-mix(in srgb, var(--color-invert-fg) 62%, transparent);
    margin-block-end: var(--space-3);
  }
  .site-footer__grid ul {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }
  .site-footer__brand p {
    margin-block-start: var(--space-4);
    max-inline-size: 30ch;
    opacity: 0.72;
  }
  .site-footer__contact {
    margin-block-start: var(--space-4);
  }
  .site-footer__meta {
    display: grid;
    align-content: start;
    gap: var(--space-2);
  }
  .site-footer__lang {
    margin-block-start: var(--space-3);
    font-weight: 500;
  }
  .site-footer__status .label {
    color: inherit;
    opacity: 0.8;
    margin-inline-end: var(--space-2);
  }
  /* The wordmark is drawn for paper; on the inverted footer it needs the inverted ink. */
  .site-footer :global(.wordmark),
  .site-footer :global(.wordmark:hover .wordmark__name) {
    color: var(--color-invert-fg);
  }
  .site-footer :global(.wordmark__mark),
  .site-footer :global(.wordmark__axiom) {
    color: var(--color-invert-brass);
  }
  .site-footer__translation .label {
    margin-inline-end: 0.5em;
    color: var(--color-invert-brass);
  }
  .site-footer__translation {
    padding-block: var(--space-3);
    border-block-start: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    font-size: var(--step--2);
    line-height: 1.6;
    opacity: 0.85;
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    justify-content: space-between;
    padding-block: var(--space-4) var(--space-5);
    border-block-start: 1px solid color-mix(in srgb, var(--color-invert-fg) 16%, transparent);
    font-size: var(--step--2);
    opacity: 0.72;
  }
  @media (max-width: 60rem) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 40rem) {
    .site-footer__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
