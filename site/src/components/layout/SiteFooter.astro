---
import Wordmark from '../shared/Wordmark.astro';
import { SECTION_PATHS, SITE_NAME, navKeys, pageCopy } from '../../config/site';
import { manifest } from '../../utils/content';
import { localePath, otherLang } from '../../utils/paths';
import { t } from '../../i18n/ui';
import type { Lang } from '../../utils/schema';

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const ui = t(lang);
const items = await Promise.all(navKeys.map(async (key) => ({ href: localePath(lang, SECTION_PATHS[key]), label: (await pageCopy(key, lang)).navLabel })));
const year = new Date().getFullYear();
const target = otherLang(lang);
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <Wordmark lang={lang} />
      <p>{ui.footerNote}</p>
    </div>
    <nav aria-label={ui.footerNav}>
      <ul role="list">
        {items.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
      </ul>
    </nav>
    <div class="site-footer__meta">
      <a href={localePath(target, path)} hreflang={target} lang={target}>{t(target).languageName}</a>
      {
        manifest.researcherApproval.status !== 'approved' && (
          <p class="site-footer__status">
            <span class="label">{ui.statusLabel}</span> {ui.awaitingReview}
          </p>
        )
      }
      <p class="site-footer__copy">
        <bdi dir="ltr">© {year} {SITE_NAME}</bdi>. {ui.rights}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--space-9);
    border-block-start: var(--border-hairline);
    background: var(--color-surface-1);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--color-ink-2);
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: var(--space-6);
    padding-block: var(--space-7) var(--space-6);
  }
  .site-footer__brand p {
    margin-block-start: var(--space-3);
    max-inline-size: 28ch;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2) var(--space-4);
    padding: 0;
    list-style: none;
  }
  a {
    color: var(--color-ink-2);
    text-decoration: none;
  }
  a:hover {
    color: var(--color-ink);
    text-decoration: underline;
  }
  .site-footer__meta {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }
  .site-footer__status .label {
    margin-inline-end: var(--space-2);
  }
  .site-footer__copy {
    color: var(--color-ink-3);
  }
  @media (max-width: 48rem) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
