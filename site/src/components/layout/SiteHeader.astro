---
import LanguageSwitcher from '../navigation/LanguageSwitcher.astro';
import Mark from '../shared/Mark.astro';
import ThemeToggle from '../navigation/ThemeToggle.astro';
import { SECTION_PATHS, SITE_NAME, navKeys, pageCopy } from '../../config/site';
import { localePath } from '../../utils/paths';
import { t } from '../../i18n/ui';
import type { Lang } from '../../utils/schema';

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const ui = t(lang);
const items = await Promise.all(
  navKeys.map(async (key) => ({ key, href: localePath(lang, SECTION_PATHS[key]), label: (await pageCopy(key, lang)).navLabel })),
);
const isCurrent = (key: string) => path === SECTION_PATHS[key as keyof typeof SECTION_PATHS] || (path.startsWith(SECTION_PATHS[key as keyof typeof SECTION_PATHS]) && key !== 'home');
// The mark is the site's own symbol — a normal-density curve on its axis inside
// a brass ring (public/images/mark.svg) — paired with the wordmark.
---

<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <a class="site-header__brand" href={localePath(lang, '/')} aria-label={SITE_NAME}>
      <Mark size="2.45rem" class="site-header__mark" intro />
      <span class="site-header__wordmark" aria-hidden="true">
        <span class="site-header__name">Ibrahim Taha</span>
        <span class="site-header__axiom">Axiom</span>
      </span>
    </a>

    <nav id="site-nav" class="site-nav" aria-label={ui.primaryNav}>
      <ul role="list">
        {
          items.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.key) ? 'page' : undefined}>
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__tools">
      <button type="button" class="search-trigger" aria-haspopup="dialog" aria-controls="site-search" data-search-open aria-keyshortcuts="Control+K Meta+K /" title={ui.searchShortcut}>
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
          <path d="M12.6 12.6 17 17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
        <span class="search-trigger__label">{ui.searchOpen}</span>
        <kbd class="search-trigger__kbd" aria-hidden="true" data-search-kbd>Ctrl K</kbd>
      </button>
      <LanguageSwitcher lang={lang} path={path} />
      <ThemeToggle lang={lang} />
      <a class="site-header__cta" href={localePath(lang, '/contact/')}>
        <span>{ui.ctaContact}</span>
        <svg viewBox="0 0 16 16" aria-hidden="true" class="icon-flip">
          <path d="M3 8h9m-3.5-3.5L12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
      <button class="menu-button" type="button" aria-controls="site-nav" aria-expanded="false" data-menu-button>
        <span class="menu-button__icon" aria-hidden="true"><span></span><span></span></span>
        <span class="menu-button__label" data-label-open={ui.menu} data-label-close={ui.closeMenu}>{ui.menu}</span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const button = header?.querySelector<HTMLButtonElement>('[data-menu-button]');
  const label = button?.querySelector<HTMLElement>('.menu-button__label');
  const set = (open: boolean) => {
    if (!header || !button || !label) return;
    header.toggleAttribute('data-open', open);
    button.setAttribute('aria-expanded', String(open));
    label.textContent = open ? label.dataset.labelClose! : label.dataset.labelOpen!;
  };
  button?.addEventListener('click', () => set(button.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header?.hasAttribute('data-open')) {
      set(false);
      button?.focus();
    }
  });
  header?.querySelectorAll('#site-nav a').forEach((a) => a.addEventListener('click', () => set(false)));
  window.matchMedia('(min-width: 60.01rem)').addEventListener('change', (m) => m.matches && set(false));
  // Show the platform's shortcut on the search button.
  if (/Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent)) {
    document.querySelectorAll('[data-search-kbd]').forEach((k) => (k.textContent = '⌘ K'));
  }
  // Condense the bar once the hero starts scrolling away.
  const onScroll = () => header?.toggleAttribute('data-condensed', window.scrollY > 24);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    inset-inline: 0;
    inset-block-start: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-paper) 82%, transparent);
    backdrop-filter: saturate(1.3) blur(18px);
    border-block-end: 1px solid transparent;
    transition: border-color var(--dur-2) var(--ease), background var(--dur-2) var(--ease);
    /* page-transition: the header is its own static layer (motion.css) */
    view-transition-name: site-header;
  }
  .site-header[data-condensed] {
    border-block-end-color: var(--color-rule);
    background: color-mix(in srgb, var(--color-paper) 92%, transparent);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    min-block-size: var(--header-height);
  }
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    flex: none;
    text-decoration: none;
    color: var(--color-ink);
  }
  .site-header__mark {
    inline-size: 2.45rem;
    block-size: 2.45rem;
    flex: none;
  }
  /* the curve inherits ink, so the mark inverts with the theme */
  .site-header__brand {
    color: var(--color-ink);
  }
  .site-header__wordmark {
    display: grid;
    gap: 0.12em;
    line-height: 1;
  }
  .site-header__name {
    font-family: var(--font-serif);
    font-size: var(--step-0);
    font-weight: 500;
    letter-spacing: -0.015em;
    white-space: nowrap;
  }
  .site-header__axiom {
    font-family: var(--font-sans);
    font-size: 0.56rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-brass);
    white-space: nowrap;
  }
  .site-header__brand:hover .site-header__name {
    color: var(--color-accent-strong);
  }
  .visually-hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  /* pill navigation, centred */
  .site-nav {
    margin-inline: auto;
    display: flex;
    align-items: center;
    padding: 0.3rem;
    border: var(--border-hairline);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-surface-1) 70%, transparent);
  }
  .site-nav ul {
    display: flex;
    gap: 0;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .site-nav a {
    display: block;
    padding: 0.5em 0.95em;
    border-radius: var(--radius-pill);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--color-ink-2);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-1) var(--ease), background var(--dur-2) var(--ease);
  }
  .site-nav a:hover {
    color: var(--color-ink);
    background: var(--color-surface-2);
  }
  .site-nav a[aria-current='page'] {
    color: var(--color-paper);
    background: var(--color-ink);
  }
  /* page-transition: the current-page pill slides to the new section (desktop row only;
     the collapsed menu is not rendered during a navigation) */
  @media (min-width: 64.01rem) {
    .site-nav a[aria-current='page'] {
      view-transition-name: nav-current;
    }
  }
  .site-header__tools {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex: none;
  }
  .site-header__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.62em 1.05em;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-paper);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: none;
    line-height: 1.2;
    transition: background var(--dur-2) var(--ease), transform var(--dur-2) var(--ease-out);
  }
  .site-header__cta svg {
    inline-size: 0.85em;
  }
  .site-header__cta:hover {
    background: var(--color-accent-strong);
    color: var(--color-paper);
    transform: translateY(-1px);
  }
  .search-trigger {
    display: none;
    align-items: center;
    gap: 0.45rem;
    min-block-size: 2.5rem;
    padding: 0.3rem 0.7rem;
    border: var(--border-hairline);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-ink-2);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    cursor: pointer;
    transition: border-color var(--dur-1) var(--ease), color var(--dur-1) var(--ease);
  }
  :global(html[data-js]) .search-trigger {
    display: inline-flex;
  }
  .search-trigger:hover {
    border-color: var(--color-rule-strong);
    color: var(--color-ink);
  }
  .search-trigger:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .search-trigger svg {
    inline-size: 1rem;
    block-size: 1rem;
  }
  .search-trigger__kbd {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.05rem 0.35rem;
    border: var(--border-hairline);
    border-radius: 4px;
    color: var(--color-ink-3);
  }
  @media (max-width: 90rem) {
    .search-trigger__kbd {
      display: none;
    }
  }
  @media (max-width: 82rem) {
    .search-trigger {
      inline-size: 2.75rem;
      block-size: 2.75rem;
      padding: 0;
      justify-content: center;
    }
    .search-trigger__label {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  .menu-button {
    display: none;
    align-items: center;
    gap: var(--space-2);
    padding: 0.6em 0.85em;
    border: var(--border-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 500;
    cursor: pointer;
  }
  .menu-button__icon {
    display: grid;
    gap: 4px;
    inline-size: 14px;
  }
  .menu-button__icon span {
    block-size: 1.5px;
    background: currentColor;
    transition: transform var(--dur-2) var(--ease);
  }
  [data-open] .menu-button__icon span:first-child {
    transform: translateY(2.75px) rotate(45deg);
  }
  [data-open] .menu-button__icon span:last-child {
    transform: translateY(-2.75px) rotate(-45deg);
  }

  /* Before the nav collapses, tighten the pills so eight sections still fit. */
  @media (max-width: 82rem) {
    .site-nav a {
      padding: 0.5em 0.62em;
      font-size: var(--step--2);
    }
    .site-header__cta span:first-child {
      display: none;
    }
    .site-header__cta {
      padding: 0.62em 0.8em;
    }
  }
  @media (max-width: 64rem) {
    .site-header__tools {
      margin-inline-start: auto;
    }
    .site-header__cta span:first-child {
      display: inline;
    }
    .site-header__cta {
      padding: 0.62em 1.05em;
    }
    .menu-button {
      display: inline-flex;
    }
    .site-nav {
      display: none;
      position: absolute;
      inset-inline: 0;
      inset-block-start: 100%;
      margin: 0;
      padding: var(--space-3) var(--gutter) var(--space-5);
      border: 0;
      border-radius: 0;
      border-block-end: var(--border-hairline);
      background: var(--color-paper);
      box-shadow: var(--shadow-panel);
    }
    [data-open] .site-nav {
      display: block;
      animation: drop var(--dur-2) var(--ease);
    }
    .site-nav ul {
      flex-direction: column;
      gap: 0;
    }
    .site-nav a {
      padding: var(--space-3) 0;
      border-radius: 0;
      font-size: var(--step-1);
    }
    .site-nav li + li {
      border-block-start: var(--border-hairline);
    }
    .site-nav a[aria-current='page'] {
      background: transparent;
      color: var(--color-accent);
    }
  }
  @media (max-width: 44rem) {
    .site-header__cta {
      display: none;
    }
    /* the mark alone carries the brand on phones; the wordmark is still read out */
    .site-header__wordmark {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  @media (max-width: 26rem) {
    .menu-button__label {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }
  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
</style>
