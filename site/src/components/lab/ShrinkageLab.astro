---
/**
 * The shrinkage lab — an illustrative, controlled experiment.
 *
 * The visitor changes one thing (how collinear the predictors are) and sees
 * three estimators respond. Every state is precomputed at build time
 * (src/lab/snapshots.ts) and every number in the prose comes from the same
 * payload (`CLAIMS`), which scripts/lab-verify.mjs re-derives after each build.
 * The figures are drawn by src/lab/draw.ts on the server for the first state
 * and redrawn in the browser from payload values; no model code ships.
 */
import DraftNote from '../shared/DraftNote.astro';
import { CLAIMS, DEFAULT_RHO, LAB_PAYLOAD, LAMBDA_GRID, PRESETS, REGIMES, STATES, TRUTH } from '../../lab/snapshots';
import { coefDomain, coefSvg, cvSvg, fmtRho, mcSvg } from '../../lab/draw';
import { getPublication } from '../../utils/publications';
import { localePath } from '../../utils/paths';
import type { Lang } from '../../utils/schema';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ar = lang === 'ar';
const C = CLAIMS;
const reps = LAB_PAYLOAD.meta.reps;
const initial = Math.max(0, STATES.findIndex((s) => s.rho === DEFAULT_RHO));
const start = LAB_PAYLOAD.states[initial];
const domain = coefDomain(LAB_PAYLOAD.states);
const n2 = (v: number) => v.toFixed(2);
const n3 = (v: number) => v.toFixed(3);
const ratioOf = (s: (typeof LAB_PAYLOAD.states)[number]) => s.mc.est.ml.spread / s.mc.est.ridge.spread;
const stateAt = (rho: number) => LAB_PAYLOAD.states.find((s) => s.rho === rho)!;
const regimeOf = (rho: number) => (rho >= REGIMES.high ? 'high' : rho >= REGIMES.moderate ? 'moderate' : 'low');
const truthList = TRUTH.map((v) => n2(v)).join(ar ? '، ' : ', ');

const name = {
  ml: ar ? 'الإمكان الأعظم' : 'Maximum likelihood',
  ridge: ar ? 'الحَرْف (Ridge)' : 'Ridge',
  ns: ar ? 'حَرْف بمعلمة مُعدَّلة بالمعيار' : 'Norm-scaled ridge',
  truth: ar ? 'القيمة الحقيقية' : 'Truth',
};
const short = {
  ml: ar ? 'الإمكان الأعظم' : 'ML',
  ridge: ar ? 'الحَرْف' : 'Ridge',
  ns: ar ? 'الحَرْف المُعدَّل' : 'NS ridge',
};

const copy = {
  kicker: ar ? 'تجربة مضبوطة للتوضيح' : 'Illustrative controlled experiment',
  title: ar ? 'ارفع الارتباط بين المتغيرات، وراقب ما يفعله كل مقدِّر.' : 'Turn up the collinearity. Watch what each estimator does with it.',
  lead: ar
    ? 'أربعة متغيرات تفسيرية، وبيانات عدّ مُحاكاة، وثلاثة مقدِّرات تُطبَّق على المشاهدات نفسها في ظل نموذج عمل واحد. المؤشر يغيّر شيئًا واحدًا: قوة الارتباط بين المتغيرات التفسيرية. السحبات العشوائية لا تتغيّر أبدًا؛ تُعاد فقط صياغة المتغيرات التفسيرية — والمشاهدات العدّية المبنية عليها — عند كل مستوى.'
    : 'Four predictors, simulated count data and three estimators fitted to the same rows under one working model. The dial changes one thing: how strongly the predictors are correlated. The random draws never change; only the predictors — and the counts built from them — are rebuilt at each level.',
  disclaimer: ar
    ? 'تجربة تعليمية، لا نتيجة بحثية. لا تُطبِّق المقدِّرات المنشورة للباحث (مقدِّرات COM-Poisson الجزائية أو LASSO أو الشبكة المرنة المرجَّحة بالارتباط)، وأرقامها مستمدّة من هذه المحاكاة وحدها.'
    : 'A teaching experiment, not a research result. It does not implement the researcher’s published COM-Poisson, LASSO or correlation-weighted elastic-net estimators, and its numbers come from this simulation alone.',
  control: ar ? 'الارتباط بين المتغيرات التفسيرية (ρ)' : 'Collinearity between the predictors (ρ)',
  controlNote: ar
    ? 'السحبات العشوائية نفسها في كل موضع؛ تُعاد صياغة المتغيرات التفسيرية والمشاهدات العدّية لكل قيمة من ρ.'
    : 'Same random draws at every position; the predictors and the counts are rebuilt for each ρ.',
  vif: ar ? 'أكبر VIF' : 'Max VIF',
  lambda: ar ? 'λ للحَرْف (بالتحقق المتقاطع)' : 'Ridge λ (by CV)',
  spreadMl: ar ? 'تشتُّت الإمكان الأعظم' : 'ML spread',
  spreadRidge: ar ? 'تشتُّت الحَرْف' : 'Ridge spread',
  ratio: ar ? 'النسبة (الإمكان الأعظم ÷ الحَرْف)' : 'Ratio ML ÷ ridge',
  presets: ar ? 'مواضع جاهزة' : 'Presets',
  dialTitle: ar ? 'ماذا يغيّر المؤشر؟' : 'What does the dial change?',
  share: ar ? 'انسخ رابط هذه الحالة' : 'Copy a link to this state',
  shared: ar ? 'نُسخ الرابط' : 'Link copied',
  shareFail: ar ? 'تعذّر النسخ؛ الرابط في شريط العنوان' : 'Could not copy; the link is in the address bar',
  coef: ar ? 'التقديرات مقابل القيمة الحقيقية' : 'Estimates against the truth',
  coefNote: ar
    ? `النقاط: التقديرات من العيّنة المعروضة. الخطوط الأفقية: متوسط مونت كارلو ± انحرافين معياريين عبر ${reps} عيّنة مُعادة. الخط المتقطّع: القيمة الحقيقية.`
    : `Dots: estimates from the displayed sample. Whiskers: Monte Carlo mean ± 2 SD over ${reps} redrawn samples. Dashed line: the true value.`,
  cv: ar ? 'اختيار λ بالتحقق المتقاطع' : 'Choosing λ by cross-validation',
  cvNote: ar
    ? 'متوسط الانحرافية (deviance) لنموذج بواسون على البيانات المحجوزة لكل مشاهدة (خمس طيّات) عند كل قيمة من شبكة λ. النقطة النحاسية هي أصغر قيمة؛ نقاط الشبكة متساوية التباعد وليست بمقياس حقيقي.'
    : 'Mean held-out Poisson deviance per row (five folds) at each grid value of λ. The brass dot is the minimum; grid points are evenly spaced, not to scale.',
  cvAxis: ar ? 'شبكة λ (تباعد متساوٍ، ليس بمقياس)' : 'λ grid (evenly spaced, not to scale)',
  mc: ar ? `عبر ${reps} عيّنة مُعادة` : `Over ${reps} redrawn samples`,
  mcSpread: ar ? 'التشتُّت (± انحرافان معياريان)' : 'Spread (± 2 SD)',
  mcRmse: ar ? 'جذر متوسط مربعات الخطأ' : 'RMSE',
  mcNoteSpread: ar
    ? 'مدى تحرّك كل مقدِّر من عيّنة إلى أخرى: ضعف الجذر التربيعي لمتوسط مربعات الانحرافات المعيارية للمعاملات الأربعة.'
    : 'How far each estimator moves from sample to sample: 2 × the root mean square of the four slopes’ standard deviations.',
  mcNoteRmse: ar
    ? 'مدى بُعد كل مقدِّر عن القيمة الحقيقية في المتوسط: جذر متوسط مربعات الخطأ عبر المعاملات الأربعة. صِغَر التشتُّت لا يعني الدقة.'
    : 'How far each estimator lands from the truth on average: root-mean-square error over the four slopes. Low spread is not the same as accuracy.',
  mcAxis: ar ? 'ρ (مواضع المؤشر، تباعد متساوٍ)' : 'ρ (dial positions, evenly spaced)',
  metricLabel: ar ? 'المقياس المعروض' : 'Metric shown',
  numbers: ar ? 'الأرقام عند هذا المستوى' : 'The numbers at this level',
  predictor: ar ? 'المتغير' : 'Predictor',
  meanSd: ar ? 'المتوسط (الانحراف المعياري)' : 'mean (SD)',
  rmse: 'RMSE',
  seNote: ar
    ? `الأخطاء المعيارية تقريبية ومبنية على النموذج (معكوس مصفوفة معلومات فيشر الجزائية في ظل نموذج العمل). تتجاهل تحيّز الانكماش وسوء تحديد التباين؛ وهي للإمكان الأعظم أكبر من انحراف مونت كارلو المعياري بنسبة تتراوح بين ${n2(C.mlSeOverSdMin)} و${n2(C.mlSeOverSdMax)} مرة على امتداد المؤشر.`
    : `Standard errors are approximate and model-based (inverse penalised Fisher information under the working model). They ignore shrinkage bias and the misspecified variance; for ML they run ${n2(C.mlSeOverSdMin)}–${n2(C.mlSeOverSdMax)}× the Monte Carlo SD across the dial.`,
  scopeShows: ar ? 'ما تُظهره التجربة' : 'What this shows',
  scopeNot: ar ? 'ما لا تُظهره' : 'What it does not show',
  methods: ar ? 'المنهج والافتراضات' : 'Methods and assumptions',
  glossary: ar ? 'مسرد المصطلحات' : 'Glossary',
  related: ar ? 'حيث يمضي البحث أبعد' : 'Where the research goes further',
  relatedNote: ar
    ? 'تدرس منشورات الباحث مقدِّرات جزائية في نماذج أغنى. نُدرجها هنا للقراءة؛ ولا يُطبَّق أيٌّ منها في هذا المختبر.'
    : 'The researcher’s publications study penalised estimators in richer models. They are listed for reading; none of them is implemented in this lab.',
  notImplemented: ar ? 'غير مُطبَّق هنا' : 'Not implemented here',
  dataset: ar ? 'مجموعة البيانات التكميلية (Zenodo، CC BY 4.0)' : 'Supplementary dataset (Zenodo, CC BY 4.0)',
  revision: ar ? 'سجل المراجعة' : 'Revision note',
};

/* Prose with computed numbers. Every number sits in a [data-claim] element whose
   data-value lab-verify compares with the payload. */
const claim = (key: keyof typeof C, text: string) => `<span data-claim="${key}" data-value="${Array.isArray(C[key]) ? (C[key] as number[]).join(',') : C[key]}">${text}</span>`;

const regimes = [
  {
    id: 'low',
    title: ar ? `دون ρ = ${REGIMES.moderate}: لا شيء يحتاج إلى علاج` : `Below ρ = ${REGIMES.moderate}: nothing to fix`,
    body: ar
      ? `مع ارتباط ضعيف تتفق المقدِّرات: في العيّنة المعروضة لا يزيد الفرق بين الإمكان الأعظم والحَرْف على ${claim('maxDiffAt0', n2(C.maxDiffAt0))} عند ρ = 0، وتشتُّتهما عبر العيّنات المُعادة متساوٍ (النسبة ${claim('ratioAt0', C.ratioAt0.toFixed(1))}). الانكماش لا يضيف شيئًا هنا.`
      : `With little collinearity the estimators agree: on the displayed sample ML and ridge differ by at most ${claim('maxDiffAt0', n2(C.maxDiffAt0))} at ρ = 0, and over redrawn samples their spreads match (ratio ${claim('ratioAt0', C.ratioAt0.toFixed(1))}). Shrinkage buys nothing here.`,
  },
  {
    id: 'moderate',
    title: ar ? `من ${REGIMES.moderate} إلى ما دون ${REGIMES.high}: إنذارات ومكاسب محدودة` : `From ${REGIMES.moderate} to below ${REGIMES.high}: warnings, modest gains`,
    body: ar
      ? `يتجاوز VIF القيمة 5 عند ρ = ${claim('firstRhoVif5', String(C.firstRhoVif5))} والقيمة 10 عند ρ = ${claim('firstRhoVif10', String(C.firstRhoVif10))}، ويتّسع تشتُّت المقدِّرات كلها. لكن أفضلية الحَرْف تبقى محدودة: تشتُّت الإمكان الأعظم ${claim('ratioAt09', C.ratioAt09.toFixed(1))} مرة قدر تشتُّت الحَرْف عند ρ = 0.9، و${claim('ratioAt095', C.ratioAt095.toFixed(1))} مرة عند 0.95.`
      : `VIF passes 5 at ρ = ${claim('firstRhoVif5', String(C.firstRhoVif5))} and 10 at ρ = ${claim('firstRhoVif10', String(C.firstRhoVif10))}, and every estimator’s spread grows. Ridge’s advantage stays modest: ML’s spread is ${claim('ratioAt09', C.ratioAt09.toFixed(1))}× ridge’s at ρ = 0.9 and ${claim('ratioAt095', C.ratioAt095.toFixed(1))}× at 0.95.`,
  },
  {
    id: 'high',
    title: ar ? `من ρ = ${REGIMES.high}: ثباتٌ ثمنه التحيّز` : `From ρ = ${REGIMES.high}: stability bought with bias`,
    body: ar
      ? `هنا يبلغ تشتُّت الإمكان الأعظم ${claim('ratioMax', C.ratioMax.toFixed(1))} مرة قدر تشتُّت الحَرْف عند ρ = ${claim('rhoMax', String(C.rhoMax))} (VIF ${claim('vifMax', C.vifMax.toFixed(1))}). يبقى الإمكان الأعظم متمركزًا حول القيمة الحقيقية لكنه يتأرجح بشدة؛ أما الحَرْف فثابت لكنه متحيّز: يشدّ المعاملات الأربعة نحو قيمة مشتركة (متوسطات تقديره ${claim('ridgeMeansMax', C.ridgeMeansMax.map(n2).join('، '))} مقابل القيم الحقيقية ${truthList})، فيحافظ تقريبًا على مجموعها (${claim('ridgeMeanSumMax', n2(C.ridgeMeanSumMax))} مقابل ${claim('truthSum', n2(C.truthSum))}) ويقلب إشارة x3. ومع ذلك يبقى جذر متوسط مربعات خطئه أقل (${claim('rmseRidgeMax', n2(C.rmseRidgeMax))} مقابل ${claim('rmseMlMax', n2(C.rmseMlMax))}).`
      : `Here ML’s spread reaches ${claim('ratioMax', C.ratioMax.toFixed(1))}× ridge’s at ρ = ${claim('rhoMax', String(C.rhoMax))} (VIF ${claim('vifMax', C.vifMax.toFixed(1))}). ML stays centred on the truth but swings widely; ridge is steady but biased — it pulls the four slopes toward a shared value (average estimates ${claim('ridgeMeansMax', C.ridgeMeansMax.map(n2).join(', '))} against the truth ${truthList}), roughly preserving their sum (${claim('ridgeMeanSumMax', n2(C.ridgeMeanSumMax))} vs ${claim('truthSum', n2(C.truthSum))}) while flipping the sign of x3. Its RMSE is still lower (${claim('rmseRidgeMax', n2(C.rmseRidgeMax))} vs ${claim('rmseMlMax', n2(C.rmseMlMax))}).`,
  },
];
const lambdaNote = ar
  ? `يرفع التحقق المتقاطع λ من ${claim('lambdaLow', String(C.lambdaLow))} إلى ${claim('lambdaMax', String(C.lambdaMax))} عند ρ = ${claim('lambdaJumpRho', String(C.lambdaJumpRho))} لأنه يختار من شبكة خشنة؛ ولهذا تنعطف منحنيات الحَرْف هناك.`
  : `Cross-validation moves λ from ${claim('lambdaLow', String(C.lambdaLow))} to ${claim('lambdaMax', String(C.lambdaMax))} at ρ = ${claim('lambdaJumpRho', String(C.lambdaJumpRho))} because it picks from a coarse grid — that is why the ridge curves bend there.`;

const presetText = (rho: number) => {
  const s = stateAt(rho);
  const v = s.vif.toFixed(1);
  if (rho === 0) return { label: ar ? 'مستقلة' : 'Independent', note: ar ? `VIF ${v}: لا شيء يحتاج إلى علاج` : `VIF ${v}: nothing to fix` };
  if (rho === 0.8) return { label: ar ? 'VIF يتجاوز 5' : 'VIF passes 5', note: `VIF ${v}` };
  if (rho === 0.9) return { label: ar ? 'VIF يتجاوز 10' : 'VIF passes 10', note: `VIF ${v}` };
  if (rho === C.rhoMax) return { label: ar ? 'شبه منفردة' : 'Near-singular', note: `VIF ${v}` };
  return {
    label: ar ? 'ارتباط حاد' : 'Severe',
    note: ar ? `تشتُّت الإمكان الأعظم ${ratioOf(s).toFixed(1)}× الحَرْف` : `ML spread ${ratioOf(s).toFixed(1)}× ridge`,
  };
};
const presets = PRESETS.map((rho) => ({ rho, index: LAB_PAYLOAD.rho.indexOf(rho), ...presetText(rho) }));

const shows = ar
  ? [
      'في ظل ارتباط قوي، تتباين تقديرات الإمكان الأعظم غير المعاقَبة عبر العيّنات المتكررة أكثر بكثير من تقديرات الحَرْف (محسوبة أعلاه).',
      'العقوبة تقايض التباين بالتحيّز، والتحقق المتقاطع يختار هذه المقايضة من البيانات.',
      'مع متغيرات مستقلة لا يكاد الانكماش يضيف شيئًا.',
    ]
  : [
      'Under strong collinearity, unpenalised estimates vary far more across repeated samples than ridge estimates (computed above).',
      'A penalty trades variance for bias, and cross-validation picks that trade-off from the data.',
      'With independent predictors there is little to gain from shrinkage.',
    ];
const notShows = ar
  ? [
      'أن الحَرْف — أو الانكماش عمومًا — أفضل دائمًا: إنه متحيّز، بل يقلب هنا إشارة أحد المعاملات.',
      'أي شيء عن المقدِّرات المنشورة للباحث (COM-Poisson الجزائية، والشبكة المرنة المرجَّحة بالارتباط)؛ لا يُطبَّق أيٌّ منها هنا.',
      'أداءً عامًا: إنه تصميم واحد فقط (n = 240، وأربعة متغيرات، ونمط ارتباط واحد، ومعلمة تشتت ثابتة φ = 6.5).',
      'استدلالًا إحصائيًا: الأخطاء المعيارية تقريبية، ولا يتضمّن شيئًا من اختبارات الفرضيات.',
    ]
  : [
      'That ridge — or shrinkage in general — is always better: it is biased, and here it even flips the sign of a coefficient.',
      'Anything about the researcher’s published estimators (penalised COM-Poisson, correlation-weighted elastic net); none of them is implemented here.',
      'General performance: this is one design (n = 240, four predictors, one correlation pattern, a fixed working dispersion φ = 6.5).',
      'Inference: the standard errors are approximations, and nothing here is a hypothesis test.',
    ];

const glossary = ar
  ? [
      ['التعدد الخطي', 'ارتباط قوي بين المتغيرات التفسيرية يجعل فصل أثر كلٍّ منها صعبًا.'],
      ['معامل تضخّم التباين (VIF)', 'مقدار تضخّم تباين تقدير المعامل بسبب ارتباط متغيره بالمتغيرات الأخرى؛ ويُعدّ تجاوز 5 أو 10 إنذارًا شائعًا.'],
      ['معلمة الجزاء λ', 'قوة العقوبة على حجم المعاملات؛ λ = 0 يعني عدم وجود عقوبة.'],
      ['التحقق المتقاطع', 'تقسيم البيانات إلى طيّات، والتقدير على بعضها، وقياس الخطأ على الطيّة المحجوزة.'],
      ['الانحرافية (deviance)', 'مقياس لعدم مطابقة القيم المتنبأ بها للمشاهدات العدّية؛ الأصغر أفضل.'],
      ['مونت كارلو', 'تكرار التجربة على عيّنات مُحاكاة كثيرة لمعرفة سلوك المقدِّر.'],
      ['التشتُّت', 'مدى تحرّك التقدير من عيّنة إلى أخرى (هنا: ± انحرافان معياريان).'],
      ['جذر متوسط مربعات الخطأ (RMSE)', 'متوسط بُعد التقدير عن القيمة الحقيقية؛ يجمع التحيّز والتباين.'],
      ['التحيّز', 'الفرق بين متوسط التقديرات عبر العيّنات والقيمة الحقيقية.'],
      ['الخطأ المعياري', 'تقدير لتباين المعامل من عيّنة واحدة؛ هنا تقريبي ومبني على النموذج.'],
    ]
  : [
      ['Collinearity', 'Strong correlation between predictors, which makes their separate effects hard to tell apart.'],
      ['VIF (variance inflation factor)', 'How much a coefficient’s variance is inflated by its predictor’s correlation with the others; 5 and 10 are common warning lines.'],
      ['Penalty λ', 'How strongly large coefficients are penalised; λ = 0 means no penalty.'],
      ['Cross-validation', 'Split the data into folds, fit on all but one, and measure the error on the held-out fold.'],
      ['Deviance', 'A measure of how badly predicted counts match the observed ones; smaller is better.'],
      ['Monte Carlo', 'Repeating the experiment on many simulated samples to see how an estimator behaves.'],
      ['Spread', 'How far the estimate moves from sample to sample (here: ± 2 SD).'],
      ['RMSE', 'Root-mean-square error: the typical distance from the truth, combining bias and variance.'],
      ['Bias', 'The gap between the average estimate over samples and the true value.'],
      ['Standard error', 'An estimate of a coefficient’s variability from one sample; here approximate and model-based.'],
    ];

const relatedKeys = ['taha2026analytical', 'taha2026development', 'rady2018ridge', 'abonazel2023beta'];
const related = relatedKeys.map((k) => getPublication(k)).filter((p) => p !== undefined);
const repoDoc = 'https://github.com/3boalazm/-Ibrahim-Taha-Axiom/blob/main/docs/lab-methodology.md';

/* Strings the client needs (labels and the live summary template). */
const i18n = {
  truth: ar ? 'الحقيقة' : 'truth',
  zero: '0',
  cvAxis: copy.cvAxis,
  mcAxis: copy.mcAxis,
  mcNoteSpread: copy.mcNoteSpread,
  mcNoteRmse: copy.mcNoteRmse,
  shared: copy.shared,
  shareFail: copy.shareFail,
  regimes: {
    low: ar ? 'ارتباط ضعيف' : 'low collinearity',
    moderate: ar ? 'ارتباط متوسط' : 'moderate collinearity',
    high: ar ? 'ارتباط حاد' : 'severe collinearity',
  },
  live: ar
    ? 'ρ = {rho} ({regime}): أكبر VIF {vif}، λ = {lambda}، التشتُّت: الإمكان الأعظم {ml} والحَرْف {ridge} (النسبة {ratio}).'
    : 'ρ = {rho} ({regime}): max VIF {vif}, λ = {lambda}, spread: ML {ml}, ridge {ridge} (ratio {ratio}).',
};
const startRegime = regimeOf(start.rho);
---

<section class="lab" aria-labelledby="lab-heading" data-lab data-i18n={JSON.stringify(i18n)} data-domain={domain} data-lambdas={JSON.stringify(LAMBDA_GRID)}>
  <div class="container lab__head">
    <p class="kicker">{copy.kicker}</p>
    <h2 id="lab-heading" class="lab__title">{copy.title}</h2>
    <p class="lab__lead">{copy.lead}</p>
    <p class="lab__disclaimer" role="note" data-lab-disclaimer>{copy.disclaimer}</p>
