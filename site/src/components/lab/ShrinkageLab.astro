<script type="application/json" id="lab-payload" set:html={JSON.stringify(LAB_PAYLOAD)} />

<script>
  import { coefSvg, cvSvg, fmtRho, mcSvg, type DrawState } from '../../lab/draw';
  import { flip } from '../../lib/motion.mjs';

  type Key = 'ml' | 'ridge' | 'ns';
  type Est = { beta: number[]; se: number[]; lambda: number };
  type Mc = { mean: number[]; sd: number[]; rmse: number[]; spread: number; rmseAll: number };
  type State = DrawState & {
    vif: number;
    corr: { x1: number; others: number };
    est: Record<Key, Est>;
    mc: { vifMean: number; est: Record<Key, Mc> };
  };
  type Payload = {
    truth: number[];
    rho: number[];
    states: State[];
    meta: { regimes: { moderate: number; high: number }; defaultRho: number };
  };
  type I18n = {
    truth: string;
    cvAxis: string;
    mcAxis: string;
    mcNoteSpread: string;
    mcNoteRmse: string;
    shared: string;
    shareFail: string;
    regimes: Record<'low' | 'moderate' | 'high', string>;
    live: string;
  };

  const root = document.querySelector<HTMLElement>('[data-lab]');
  const payloadEl = document.getElementById('lab-payload');
  const range = root?.querySelector<HTMLInputElement>('[data-lab-range]');
  if (root && payloadEl && range) {
    const cfg = JSON.parse(payloadEl.textContent ?? '{}') as Payload;
    const i18n = JSON.parse(root.dataset.i18n ?? '{}') as I18n;
    const domain = Number(root.dataset.domain);
    const lambdas = JSON.parse(root.dataset.lambdas ?? '[]') as number[];
    const KEYS: Key[] = ['ml', 'ridge', 'ns'];
    const $ = <T extends Element>(sel: string) => root.querySelector<T>(sel);
    const coefBox = $<HTMLElement>('[data-lab-coef]');
    const cvBox = $<HTMLElement>('[data-lab-cv]');
    const mcBox = $<HTMLElement>('[data-lab-mc]');
    const mcNote = $<HTMLElement>('[data-lab-mc-note]');
    const live = $<HTMLElement>('[data-lab-live]');
    const presets = [...root.querySelectorAll<HTMLButtonElement>('[data-lab-preset]')];
    const metricButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-lab-metric]')];
    const readings = [...root.querySelectorAll<HTMLElement>('[data-lab-regime]')];
    const scale = [...root.querySelectorAll<HTMLElement>('.lab__scale span')];
    let metric: 'spread' | 'rmse' = 'spread';
    let current = Number(range.value);
    let liveTimer = 0;

    const regimeOf = (rho: number) => (rho >= cfg.meta.regimes.high ? 'high' : rho >= cfg.meta.regimes.moderate ? 'moderate' : 'low');
    const setText = (name: string, value: string) => root.querySelectorAll<HTMLElement>(`[data-lab="${name}"]`).forEach((el) => (el.textContent = value));
    const nearest = (rho: number) => cfg.rho.reduce((best, r, i) => (Math.abs(r - rho) < Math.abs(cfg.rho[best] - rho) ? i : best), 0);

    function readUrl(): number | null {
      const raw = new URLSearchParams(location.search).get('rho');
      if (raw === null || raw.trim() === '') return null;
      const v = Number(raw);
      return Number.isFinite(v) && v >= 0 && v <= 1 ? nearest(v) : null;
    }
    function writeUrl(i: number) {
      const url = new URL(location.href);
      if (cfg.rho[i] === cfg.meta.defaultRho) url.searchParams.delete('rho');
      else url.searchParams.set('rho', String(cfg.rho[i]));
      history.replaceState(history.state, '', url);
    }

    function drawMc() {
      if (mcBox) mcBox.innerHTML = mcSvg(cfg.states, metric, current, { axis: i18n.mcAxis });
      if (mcNote) mcNote.textContent = metric === 'spread' ? i18n.mcNoteSpread : i18n.mcNoteRmse;
    }

    function render(i: number, opts: { url?: boolean; announce?: boolean } = {}) {
      const s = cfg.states[i];
      if (!s) return;
      current = i;
      const rhoText = `ρ = ${fmtRho(s.rho)}`;
      const ratio = s.mc.est.ml.spread / s.mc.est.ridge.spread;
      const regime = regimeOf(s.rho);
      range!.value = String(i);
      range!.setAttribute('aria-valuetext', rhoText);
      range!.style.setProperty('--lab-progress', `${(i / (cfg.states.length - 1)) * 100}%`);
      setText('rho', rhoText);
      setText('rho-inline', `(${rhoText})`);
      setText('regime', i18n.regimes[regime]);
      setText('vif', s.vif.toFixed(1));
      setText('lambda', String(s.lambda));
      setText('spread-ml', s.mc.est.ml.spread.toFixed(3));
      setText('spread-ridge', s.mc.est.ridge.spread.toFixed(3));
      setText('ratio', `${ratio.toFixed(1)}×`);
      setText('corr-x1', s.corr.x1.toFixed(3));
      setText('corr-others', s.corr.others.toFixed(3));
      scale.forEach((el, k) => el.classList.toggle('is-current', k === i));
      presets.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.labPreset) === i)));
      readings.forEach((r) => r.toggleAttribute('data-active', r.dataset.labRegime === regime));

      // Geometry moves from the previous state to this one (≤ --motion-base, instant
      // under reduced motion). Every readout above and both tables below are already
      // the exact values of the selected state; nothing numeric is interpolated.
      flip(root!, () => {
        if (coefBox) coefBox.innerHTML = coefSvg(s, cfg.truth, domain, { truth: i18n.truth, zero: '0' });
        if (cvBox) cvBox.innerHTML = cvSvg(s, lambdas, { axis: i18n.cvAxis });
        drawMc();
      });

      root!.querySelectorAll<HTMLTableRowElement>('[data-lab-table="sample"] tr').forEach((tr, j) => {
        const cells = tr.querySelectorAll('td');
        KEYS.forEach((k, c) => (cells[c + 1].textContent = `${s.est[k].beta[j].toFixed(3)} (${s.est[k].se[j].toFixed(3)})`));
      });
      KEYS.forEach((k) => {
        const cell = root!.querySelector(`[data-lab-lambda="${k}"]`);
        if (cell) cell.textContent = String(s.est[k].lambda);
      });
      root!.querySelectorAll<HTMLTableRowElement>('[data-lab-table="mc"] tr').forEach((tr, j) => {
        const cells = tr.querySelectorAll('td');
        KEYS.forEach((k, c) => {
          const m = s.mc.est[k];
          cells[1 + c * 2].textContent = `${m.mean[j].toFixed(3)} (${m.sd[j].toFixed(3)})`;
          cells[2 + c * 2].textContent = m.rmse[j].toFixed(3);
        });
      });

      if (opts.url !== false) writeUrl(i);
      if (opts.announce !== false && live) {
        clearTimeout(liveTimer);
        liveTimer = window.setTimeout(() => {
          live.textContent = i18n.live
            .replace('{rho}', fmtRho(s.rho))
            .replace('{regime}', i18n.regimes[regime])
            .replace('{vif}', s.vif.toFixed(1))
            .replace('{lambda}', String(s.lambda))
            .replace('{ml}', s.mc.est.ml.spread.toFixed(2))
            .replace('{ridge}', s.mc.est.ridge.spread.toFixed(2))
            .replace('{ratio}', `${ratio.toFixed(1)}×`);
        }, 450);
      }
    }

    let frame = 0;
    range.addEventListener('input', () => {
      if (frame) cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        frame = 0;
        render(Number(range.value));
      });
    });
    presets.forEach((b) =>
      b.addEventListener('click', () => {
        render(Number(b.dataset.labPreset));
      }),
    );
    metricButtons.forEach((b) =>
      b.addEventListener('click', () => {
        metric = b.dataset.labMetric === 'rmse' ? 'rmse' : 'spread';
        metricButtons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        flip(mcBox, drawMc);
      }),
    );
    const shareStatus = $<HTMLElement>('[data-lab-share-status]');
    $<HTMLButtonElement>('[data-lab-share]')?.addEventListener('click', async () => {
      writeUrl(current);
      try {
        await navigator.clipboard.writeText(location.href);
        if (shareStatus) shareStatus.textContent = i18n.shared;
      } catch {
        if (shareStatus) shareStatus.textContent = i18n.shareFail;
      }
      setTimeout(() => shareStatus && (shareStatus.textContent = ''), 2600);
    });

    const fromUrl = readUrl();
    if (fromUrl !== null && fromUrl !== current) render(fromUrl, { url: false, announce: false });
  }
</script>

