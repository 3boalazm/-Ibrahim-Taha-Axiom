---
/**
 * Contact composer: four enquiry paths (collaboration, consulting,
 * supervision, speaking) that prepare a message for the visitor's OWN mail
 * app (mailto) or copy it to the clipboard. Nothing is sent from this site:
 * no endpoint, no form service, no tracking, no storage. Status messages say
 * exactly that — never "Message sent". Without JavaScript the plain mailto
 * links remain.
 */
import { t } from '../../i18n/ui';
import type { Lang } from '../../utils/schema';

interface Props {
  lang: Lang;
  email: string;
}
const { lang, email } = Astro.props;
const ui = t(lang);
const ar = lang === 'ar';
const paths = ar
  ? [
      { id: 'collaboration', subject: 'تعاون بحثي', label: 'تعاون بحثي', note: 'ورقة أو مشروع أو بيانات مشتركة', prompt: 'اذكر السؤال البحثي، ونوع البيانات، والدور الذي تقترحه، والإطار الزمني.' },
      { id: 'consulting', subject: 'استشارة إحصائية', label: 'استشارة إحصائية', note: 'تحليل بيانات أو مراجعة منهجية', prompt: 'صف البيانات (الحجم ونوع المتغيرات)، والسؤال المطلوب الإجابة عنه، والموعد النهائي.' },
      { id: 'supervision', subject: 'إشراف أكاديمي', label: 'إشراف أكاديمي', note: 'رسائل الماجستير والدكتوراه', prompt: 'اذكر برنامجك وجامعتك، وموضوع الرسالة، والمرحلة التي وصلت إليها.' },
      { id: 'speaking', subject: 'دعوة لمحاضرة أو ورشة', label: 'محاضرة أو ورشة', note: 'المؤتمرات والتدريب', prompt: 'اذكر الجهة، والموضوع، والتاريخ، والمدة، والجمهور المتوقع.' },
    ]
  : [
      { id: 'collaboration', subject: 'Research collaboration', label: 'Research collaboration', note: 'A joint paper, project or dataset', prompt: 'Mention the research question, the data, the role you have in mind and the timeline.' },
      { id: 'consulting', subject: 'Statistical consulting', label: 'Statistical consulting', note: 'Data analysis or a methods review', prompt: 'Describe the data (size, kinds of variables), the question to answer and the deadline.' },
      { id: 'supervision', subject: 'Academic supervision', label: 'Supervision', note: "Master's and doctoral work", prompt: 'Mention your programme and university, the thesis topic and how far along you are.' },
      { id: 'speaking', subject: 'Lecture or workshop invitation', label: 'Lecture or workshop', note: 'Conference and training invitations', prompt: 'Mention the organiser, topic, date, length and expected audience.' },
    ];
const L = ar
  ? {
      legend: 'ما موضوع رسالتك؟',
      name: 'الاسم (اختياري)',
      org: 'الجهة (اختياري)',
      message: 'الرسالة',
      submit: 'افتح في تطبيق البريد',
      copy: 'انسخ الرسالة',
      opened: 'يُفترض أن يفتح تطبيق البريد لديك الآن والرسالة جاهزة؛ لم يُرسَل شيء بعد. إن لم يحدث شيء فاستخدم «انسخ الرسالة».',
      copied: `نُسخت الرسالة. الصقها في بريد جديد إلى ${email}.`,
      copyFailed: 'تعذّر النسخ تلقائيًا؛ حدِّد النص أدناه وانسخه يدويًا.',
      tooShort: 'اكتب رسالة من 20 حرفًا على الأقل.',
      privacy: 'لا يُرسَل شيء من هذا الموقع: الزر يسلّم الرسالة إلى تطبيق البريد لديك، وزر النسخ يضعها في الحافظة. لا خدمة نماذج، ولا تتبّع، ولا تخزين.',
      fallbackLabel: 'نص الرسالة للنسخ اليدوي',
      count: '{n} / 1500',
      signature: 'أُعدّت عبر صفحة التواصل في الموقع',
      to: 'إلى',
      subject: 'الموضوع',
    }
  : {
      legend: 'What is this about?',
      name: 'Name (optional)',
      org: 'Affiliation (optional)',
      message: 'Message',
      submit: 'Open in my mail app',
      copy: 'Copy message',
      opened: 'Your mail app should now open with the message ready — nothing has been sent yet. If nothing happened, use “Copy message”.',
      copied: `Copied. Paste it into a new email to ${email}.`,
      copyFailed: 'Could not copy automatically — select the text below and copy it.',
      tooShort: 'Please write at least 20 characters.',
      privacy: 'Nothing is sent from this website: the button hands the message to your own mail app and the copy button puts it on your clipboard. No form service, no tracking, no storage.',
      fallbackLabel: 'Message text for manual copying',
      count: '{n} / 1500',
      signature: 'Prepared on the contact page of the website',
      to: 'To',
      subject: 'Subject',
    };
---

<form class="composer" id="composer" data-composer data-email={email} data-l={JSON.stringify(L)} novalidate>
  <fieldset class="composer__paths">
    <legend class="composer__legend">{L.legend}</legend>
    {
      paths.map((p, i) => (
        <label class="composer__path">
          <input type="radio" name="path" value={p.id} checked={i === 0} data-subject={p.subject} data-prompt={p.prompt} />
          <span class="composer__path-label">{p.label}</span>
          <span class="composer__path-note">{p.note}</span>
        </label>
      ))
    }
  </fieldset>

  <div class="composer__grid">
    <div class="composer__field">
      <label for="composer-name">{L.name}</label>
      <input id="composer-name" name="name" autocomplete="name" maxlength="120" dir="auto" />
    </div>
    <div class="composer__field">
      <label for="composer-org">{L.org}</label>
      <input id="composer-org" name="org" autocomplete="organization" maxlength="160" dir="auto" />
    </div>
    <div class="composer__field composer__field--wide">
      <label for="composer-message">{L.message}</label>
      <textarea id="composer-message" name="message" rows="6" maxlength="1500" required aria-describedby="composer-prompt composer-count composer-error" dir="auto"></textarea>
      <div class="composer__meta">
        <p id="composer-prompt" class="composer__prompt" data-composer-prompt>{paths[0].prompt}</p>
        <p id="composer-count" class="composer__count ltr" data-composer-count>0 / 1500</p>
      </div>
      <p id="composer-error" class="composer__error" data-composer-error hidden></p>
    </div>
  </div>

  <div class="composer__actions">
    <button type="submit" class="button button--accent">{L.submit}</button>
    <button type="button" class="button" data-composer-copy>{L.copy}</button>
  </div>
  <p class="composer__status" role="status" data-composer-status></p>
  <label class="visually-hidden" for="composer-fallback">{L.fallbackLabel}</label>
  <textarea id="composer-fallback" class="composer__fallback" readonly rows="7" hidden data-composer-fallback dir="auto"></textarea>
  <p class="composer__privacy">{L.privacy}</p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-composer]').forEach((form) => {
    const L = JSON.parse(form.dataset.l ?? '{}');
    const email = form.dataset.email!;
    const message = form.querySelector<HTMLTextAreaElement>('#composer-message')!;
    const prompt = form.querySelector<HTMLElement>('[data-composer-prompt]')!;
    const count = form.querySelector<HTMLElement>('[data-composer-count]')!;
    const error = form.querySelector<HTMLElement>('[data-composer-error]')!;
    const status = form.querySelector<HTMLElement>('[data-composer-status]')!;
    const fallback = form.querySelector<HTMLTextAreaElement>('[data-composer-fallback]')!;
    const radios = [...form.querySelectorAll<HTMLInputElement>('input[name="path"]')];
    const current = () => radios.find((r) => r.checked) ?? radios[0];

    radios.forEach((r) => r.addEventListener('change', () => (prompt.textContent = current().dataset.prompt ?? '')));
    // ?path=consulting (from the home page) preselects a path; unknown values are ignored.
    const wanted = new URLSearchParams(window.location.search).get('path');
    const preset = radios.find((r) => r.value === wanted);
    if (preset) {
      preset.checked = true;
      prompt.textContent = preset.dataset.prompt ?? '';
    }
    message.addEventListener('input', () => {
      count.textContent = L.count.replace('{n}', String(message.value.length));
      if (!error.hidden && message.value.trim().length >= 20) {
        error.hidden = true;
        message.removeAttribute('aria-invalid');
      }
    });

    function compose() {
      const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();
      const org = (form.elements.namedItem('org') as HTMLInputElement).value.trim();
      const subject = `${current().dataset.subject}${name ? ` — ${name}` : ''}`;
      const sign = [name, org].filter(Boolean).join('\n');
      const body = `${message.value.trim()}\n\n${sign ? `${sign}\n` : ''}— ${L.signature}`;
      return { subject, body };
    }
    function valid() {
      if (message.value.trim().length >= 20) return true;
      error.textContent = L.tooShort;
      error.hidden = false;
      message.setAttribute('aria-invalid', 'true');
      message.focus();
      return false;
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!valid()) return;
      const { subject, body } = compose();
      status.textContent = L.opened;
      window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
    form.querySelector('[data-composer-copy]')?.addEventListener('click', async () => {
      if (!valid()) return;
      const { subject, body } = compose();
      const text = `${L.to}: ${email}\n${L.subject}: ${subject}\n\n${body}`;
      try {
        await navigator.clipboard.writeText(text);
        status.textContent = L.copied;
        fallback.hidden = true;
      } catch {
        status.textContent = L.copyFailed;
        fallback.value = text;
        fallback.hidden = false;
        fallback.focus();
        fallback.select();
      }
    });
  });
</script>

<style>
  .composer {
    display: none;
    gap: var(--space-4);
  }
  :global(html[data-js]) .composer {
    display: grid;
  }
  .composer__paths {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    border: 0;
  }
  .composer__legend {
    grid-column: 1 / -1;
    margin-block-end: var(--space-2);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 600;
  }
  .composer__path {
    position: relative;
    display: grid;
    gap: 0.15rem;
    padding: var(--space-3) var(--space-4);
    padding-inline-start: 2.6rem;
    border: var(--border-hairline);
    border-radius: var(--radius-2);
    background: var(--color-paper);
    cursor: pointer;
  }
  .composer__path input {
    position: absolute;
    inset-inline-start: 0.95rem;
    inset-block-start: 1.05rem;
    inline-size: 1rem;
    block-size: 1rem;
    accent-color: var(--color-accent);
  }
  .composer__path:has(input:checked) {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }
  .composer__path:has(input:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .composer__path-label {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 600;
  }
  .composer__path-note {
    font-family: var(--font-ui);
    font-size: var(--step--2);
    color: var(--color-ink-3);
  }
  .composer__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .composer__field {
    display: grid;
    gap: var(--space-1);
  }
  .composer__field--wide {
    grid-column: 1 / -1;
  }
  .composer__field label {
    font-family: var(--font-ui);
    font-size: var(--step--2);
    color: var(--color-ink-2);
  }
  .composer__field input,
  .composer__field textarea,
  .composer__fallback {
    inline-size: 100%;
    min-block-size: 2.75rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius-2);
    background: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-ui);
    font-size: var(--step-0);
    line-height: 1.5;
  }
  .composer__field textarea {
    resize: vertical;
  }
  .composer__field input:focus-visible,
  .composer__field textarea:focus-visible,
  .composer__fallback:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 1px;
  }
  .composer__field textarea[aria-invalid='true'] {
    border-color: var(--color-focus);
  }
  .composer__meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .composer__prompt,
  .composer__count,
  .composer__privacy {
    font-family: var(--font-ui);
    font-size: var(--step--2);
    color: var(--color-ink-3);
  }
  .composer__count {
    flex: none;
  }
  .composer__error {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--color-focus);
  }
  .composer__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .composer__status {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--color-ink-2);
  }
  .composer__status:empty {
    display: none;
  }
  .composer__fallback {
    inline-size: 100%;
    font-size: var(--step--1);
  }
  @media (max-width: 40rem) {
    .composer__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
