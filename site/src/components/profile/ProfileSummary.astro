---
/** Approved profile fields only (see utils/content.ts). */
import LangText from '../shared/LangText.astro';
import Picture from '../media/Picture.astro';
import { PICTURES } from '../../utils/imagery';
import { pick, profile } from '../../utils/content';
import { t } from '../../i18n/ui';
import type { Lang } from '../../utils/schema';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const ar = lang === 'ar';
const bio = pick(profile.biography, lang);
const summary = pick(profile.summary, lang);
const labels = {
  bio: ar ? 'السيرة' : 'Biography',
  facts: ar ? 'في سطور' : 'At a glance',
};
---

<div class="profile">
  <div class="profile__main">
    {(profile.name.en || profile.name.ar) && (
      <p class="profile__name">
        <LangText value={profile.name} lang={lang} />
      </p>
    )}
    {(profile.role.en || profile.role.ar) && (
      <p class="profile__role">
        <LangText value={profile.role} lang={lang} />
      </p>
    )}

    {
      summary && !summary.fallback && (
        <p class="profile__summary" lang={summary.fallback ? summary.lang : undefined}>
          {summary.text}
        </p>
      )
    }

    {
      bio && (
        <div class="profile__bio prose" lang={bio.fallback ? bio.lang : undefined} dir={bio.fallback ? (bio.lang === 'ar' ? 'rtl' : 'ltr') : undefined}>
          <p class="kicker">{labels.bio}</p>
          {bio.text.split(/\n\s*\n/).map((para) => (
            <p>{para}</p>
          ))}
        </div>
      )
    }
    {bio?.fallback && <p class="fallback-note">{ui.translationFallback}</p>}

    {
      profile.interests.length > 0 && (
        <div class="profile__interests">
          <h2 class="label">{ui.interests}</h2>
          <ul role="list">
            {profile.interests.map((i) => (
              <li class="chip">{(ar ? i.ar : i.en) ?? i.en ?? i.ar}</li>
            ))}
          </ul>
        </div>
      )
    }
  </div>

  <aside class="profile__facts">
    <figure class="profile__portrait">
      <Picture picture={PICTURES.portrait} lang={lang} ratio="4 / 5" objectPosition="50% 20%" class="profile__shot" />
      <figcaption class="profile__caption">
        <span class="profile__caption-name"><LangText value={profile.name} lang={lang} /></span>
        <span class="profile__caption-role"><LangText value={profile.role} lang={lang} /></span>
      </figcaption>
    </figure>

    {
      profile.affiliations.length > 0 && (
        <section class="fact">
          <h2 class="label">{ui.affiliations}</h2>
          <ul role="list">
            {profile.affiliations.map((a) => (
              <li>
                <span class="fact__strong">
                  <LangText value={a.organization} lang={lang} />
                </span>
                {a.department && <LangText value={a.department} lang={lang} as="p" />}
                {a.role && <LangText value={a.role} lang={lang} as="p" />}
                {(a.from || a.to) && (
                  <p class="fact__period ltr">
                    {a.from ?? ''}–{a.to ?? (ar ? 'الآن' : 'present')}
                  </p>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      profile.education.length > 0 && (
        <section class="fact">
          <h2 class="label">{ui.education}</h2>
          <ul role="list">
            {profile.education.map((e) => (
              <li>
                <span class="fact__strong">
                  <LangText value={e.degree} lang={lang} />
                </span>
                <p>
                  <LangText value={e.institution} lang={lang} />
                  {e.year && <span> · <span class="ltr">{e.year}</span></span>}
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      profile.identifiers.length > 0 && (
        <section class="fact">
          <h2 class="label">{ui.identifiers}</h2>
          <ul class="fact__ids" role="list">
            {profile.identifiers.map((i) => (
              <li>
                <a href={i.url} rel="me noopener">
                  <span>{i.type}</span>
                  <span class="ltr id-value">{i.value}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      (profile.contact.email || profile.contact.phone) && (
        <section class="fact">
          <h2 class="label">{ui.contactDirect}</h2>
          <ul role="list">
            {profile.contact.email && (
              <li>
                <a class="ltr" href={`mailto:${profile.contact.email}`}>{profile.contact.email}</a>
              </li>
            )}
            {profile.contact.phone && (
              <li>
                <a class="ltr" href={`tel:${profile.contact.phone.replace(/[\s-]/g, '')}`}>{profile.contact.phone}</a>
              </li>
            )}
          </ul>
        </section>
      )
    }
  </aside>
</div>

<style>
  .profile {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(var(--space-6), 5vw, var(--space-8));
    align-items: start;
  }
  .profile__main {
    display: grid;
    gap: var(--space-4);
    max-inline-size: 44rem;
  }
  .profile__name {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .profile__role {
    font-family: var(--font-ui);
    font-size: var(--step-0);
    color: var(--color-ink-3);
  }
  .profile__summary {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 300;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    text-wrap: pretty;
  }
  :lang(ar) .profile__summary {
    font-family: var(--font-ar-display);
    font-weight: 400;
    line-height: 1.7;
  }
  .profile__bio {
    display: grid;
    gap: var(--space-3);
    padding-block-start: var(--space-5);
    border-block-start: var(--border-hairline);
  }
  .profile__bio p {
    color: var(--color-ink-2);
  }
  .profile__interests {
    padding-block-start: var(--space-4);
  }
  .profile__interests ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin-block-start: var(--space-3);
    list-style: none;
  }
  .profile__facts {
    display: grid;
    gap: var(--space-5);
    align-content: start;
    padding: var(--space-5);
    border: var(--border-hairline);
    border-radius: var(--radius-3);
    background: var(--color-surface-1);
    box-shadow: var(--shadow-card);
  }
  .profile__portrait {
    display: grid;
    gap: var(--space-2);
    margin: 0;
  }
  .profile__portrait :global(.profile__shot) {
    display: block;
    inline-size: 100%;
    border-radius: var(--radius-2);
    box-shadow: var(--shadow-card);
  }
  .profile__caption {
    display: grid;
    gap: 2px;
    padding-block-start: var(--space-2);
    border-block-start: var(--border-hairline);
  }
  .profile__caption-name {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--color-ink);
  }
  .profile__caption-role {
    font-family: var(--font-ui);
    font-size: var(--step--2);
    color: var(--color-ink-3);
  }
  .fact {
    padding-block-start: var(--space-4);
    border-block-start: var(--border-hairline);
  }
  .fact:first-of-type {
    border-block-start: 0;
  }
  .fact ul {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    margin-block-start: var(--space-3);
    list-style: none;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--color-ink-2);
  }
  .fact__strong {
    font-weight: 500;
    color: var(--color-ink);
  }
  .fact__period {
    margin-block-start: var(--space-1);
    font-size: var(--step--2);
    color: var(--color-ink-3);
  }
  .fact__ids {
    gap: var(--space-1) !important;
  }
  .fact__ids a {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-2);
    border-block-end: var(--border-hairline);
    color: var(--color-ink);
    text-decoration: none;
  }
  .fact__ids a:hover {
    color: var(--color-accent);
  }
  .id-value {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--color-ink-3);
  }
  .fallback-note {
    font-family: var(--font-ui);
    font-size: var(--step--2);
    color: var(--color-ink-3);
  }
  @media (max-width: 64rem) {
    .profile {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
