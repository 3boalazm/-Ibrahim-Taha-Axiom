---
import AuthorList from './AuthorList.astro';
import CiteBlock from './CiteBlock.astro';
import LangText from '../shared/LangText.astro';
import { methods, projects, researchAreas } from '../../utils/content';
import { areasOf, methodsOf, projectsOf } from '../../utils/relations';
import { t } from '../../i18n/ui';
import { localePath } from '../../utils/paths';
import type { Publication } from '../../utils/publications';
import type { Lang } from '../../utils/schema';

interface Props {
  pub: Publication;
  lang: Lang;
  /** Rendered inside a list of works: no abstract/citation panels. */
  compact?: boolean;
  /** Position in a numbered list, for the editorial index numeral. */
  index?: number;
  /** Show verified area/project/method links (from manifest relationships). */
  related?: boolean;
}
const { pub, lang, compact = false, index, related = true } = Astro.props;
const ui = t(lang);
const ar = lang === 'ar';
const href = localePath(lang, `/publications/${pub.key}/`);
const kind = pub.type === 'book' || pub.type === 'book-chapter' ? 'book' : 'publication';
const relAreas = related ? areasOf(pub.key).flatMap((id) => researchAreas.filter((a) => a.id === id)) : [];
const relProjects = related ? projectsOf(pub.key).flatMap((id) => projects.filter((x) => x.id === id)) : [];
const relMethods = related ? methodsOf(pub.key).flatMap((id) => methods.filter((m) => m.id === id)) : [];
const researchPath = localePath(lang, '/research/');
const projectsPath = localePath(lang, '/projects/');
---

<article class:list={['pub', { 'pub--selected': pub.selected, 'pub--compact': compact }]} data-pub data-key={pub.key} data-type={pub.type} data-selected={String(pub.selected)}>
  <div class="pub__grid">
    <div class="pub__aside">
      {index !== undefined && <span class="pub__index ltr">{String(index).padStart(2, '0')}</span>}
      <span class="pub__year ltr">{pub.year ?? 'n.d.'}</span>
    </div>

    <div class="pub__main">
      <p class="pub__meta">
        <span class="pub__type" style={`--badge: var(--type-${kind})`}>{ui.types[pub.type]}</span>
        {pub.selected && <span class="pub__flag">{ui.selected}</span>}
        {pub.abbr && <span class="pub__abbr ltr">{pub.abbr}</span>}
        {pub.award && <span class="pub__flag" dir="auto">{pub.award}</span>}
      </p>

      <h3 class="pub__title" lang={pub.titleLang ?? undefined} dir="auto">
        <a href={href}>{pub.title}</a>
      </h3>

      <AuthorList authors={pub.authors} lang={lang} />

      <p class="pub__venue">
        {pub.venue && <cite lang={pub.venueLang ?? undefined} dir="auto">{pub.venue}</cite>}
        {pub.volume && <span class="ltr">{pub.volume}{pub.number ? `(${pub.number})` : ''}</span>}
        {pub.pages && <span class="ltr">{pub.pages}</span>}
      </p>

      {
        !compact && relAreas.length + relProjects.length + relMethods.length > 0 && (
          <ul class="pub__related" role="list">
            {relAreas.map((a) => (
              <li>
                <a class="pub__chip pub__chip--area" href={`${researchPath}#${a.id}`}>
                  <span class="visually-hidden">{ui.relatedAreas}: </span>
                  <LangText value={a.title} lang={lang} />
                </a>
              </li>
            ))}
            {relProjects.map((x) => (
              <li>
                <a class="pub__chip pub__chip--project" href={`${projectsPath}#${x.id}`}>
                  <span class="visually-hidden">{ui.relatedProjects}: </span>
                  <LangText value={x.title} lang={lang} />
                </a>
              </li>
            ))}
            {relMethods.map((m) => (
              <li>
                <a class="pub__chip pub__chip--method" href={`${researchPath}?focus=method:${m.id}#knowledge-graph`}>
                  <span class="visually-hidden">{ui.relatedMethods}: </span>
                  <LangText value={m.title} lang={lang} />
                </a>
              </li>
            ))}
          </ul>
        )
      }

      {
        !compact && (
          <div class="pub__actions">
            <a class="pub__open" href={href}>
              {ui.details}
              <svg viewBox="0 0 16 16" aria-hidden="true" class="icon-flip">
                <path d="M3 8h9m-3.5-3.5L12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            {pub.doi && (
              <a class="pub__doi doi" href={`https://doi.org/${pub.doi}`} rel="noopener">
                doi:{pub.doi}
              </a>
            )}
            {pub.links.map((l) => (
              <a class="pub__link" href={l.href} rel="noopener">
                {ui.linkLabels[l.kind]}
              </a>
            ))}
          </div>
        )
      }

      {
        !compact && pub.abstract && (
          <details class="disclosure pub__abstract">
            <summary>{ui.abstract}</summary>
            <p lang={pub.titleLang ?? undefined} dir="auto">
              {pub.abstract}
            </p>
          </details>
        )
      }
      {!compact && <CiteBlock pub={pub} lang={lang} />}
    </div>
  </div>
</article>

<style>
  .pub__related {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    margin: 0;
    padding: 0;
  }
  .pub__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-block-size: 1.9rem;
    padding: 0.15rem 0.6rem;
    border: var(--border-hairline);
    border-radius: var(--radius-pill);
    font-family: var(--font-ui);
    font-size: var(--step--2);
    color: var(--color-ink-2);
    text-decoration: none;
  }
  .pub__chip::before {
    content: '';
    inline-size: 0.45rem;
    block-size: 0.45rem;
    border-radius: 50%;
    background: var(--chip, var(--color-accent));
    flex: none;
  }
  .pub__chip--project {
    --chip: var(--color-brass);
  }
  .pub__chip--method {
    --chip: var(--color-ink-3);
  }
  .pub__chip:hover {
    border-color: var(--color-rule-strong);
    color: var(--color-ink);
  }
  .pub {
    position: relative;
    padding-block: var(--space-5);
    border-block-end: var(--border-hairline);
  }
  .pub__grid {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-5);
  }
  .pub__aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    align-items: flex-start;
    padding-block-start: 0.15em;
  }
  .pub__index {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.12em;
    color: var(--color-brass);
  }
  .pub__year {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 400;
    line-height: 1;
    color: var(--color-ink-3);
    font-variant-numeric: lining-nums;
  }
  .pub--selected .pub__year {
    color: var(--color-accent);
  }
  .pub__main {
    display: grid;
    gap: var(--space-2);
    min-inline-size: 0;
  }
  .pub__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    font-family: var(--font-ui);
    font-size: var(--step--2);
  }
  .pub__type {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }
  :lang(ar) .pub__type {
    text-transform: none;
    letter-spacing: 0;
    font-size: var(--step--1);
  }
  .pub__type::before {
    content: '';
    inline-size: 0.45em;
    block-size: 0.45em;
    border-radius: 50%;
    background: var(--badge);
  }
  .pub__flag,
  .pub__abbr {
    font-weight: 600;
    padding: 0.1em 0.6em;
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
  }
  .pub__abbr {
    background: transparent;
    border: var(--border-hairline);
    color: var(--color-ink-2);
  }
  .pub__title {
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.28;
    letter-spacing: -0.015em;
    text-align: match-parent;
  }
  .pub__title a {
    color: var(--color-ink);
    text-decoration: none;
    background-image: linear-gradient(var(--color-accent), var(--color-accent));
    background-size: 0% 1px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition: background-size var(--dur-2) var(--ease), color var(--dur-1) var(--ease);
  }
  .pub__title a:hover {
    background-size: 100% 1px;
    color: var(--color-accent);
  }
  .pub__venue {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--color-ink-3);
  }
  .pub__venue cite {
    font-style: italic;
    color: var(--color-ink-2);
  }
  .pub__venue cite:lang(ar) {
    font-style: normal;
  }
  .pub__venue > * + *::before {
    content: '·';
    margin-inline-end: var(--space-2);
    color: var(--color-rule-strong);
  }
  .pub__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin-block-start: var(--space-1);
    font-family: var(--font-ui);
    font-size: var(--step--1);
  }
  .pub__open {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.35em 0.8em;
    border: var(--border-hairline);
    border-radius: var(--radius-pill);
    font-weight: 500;
    text-decoration: none;
    color: var(--color-ink);
    transition: background var(--dur-2) var(--ease), border-color var(--dur-2) var(--ease), color var(--dur-2) var(--ease);
  }
  .pub__open svg {
    inline-size: 0.8em;
  }
  .pub__open:hover {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-paper);
  }
  .pub__link {
    text-decoration: none;
    border-block-end: 1px solid var(--color-rule);
    padding-block-end: 0.1em;
    color: var(--color-ink-2);
  }
  .pub__link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .pub__doi {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--color-ink-3);
    word-break: break-all;
  }
  .pub__doi:hover {
    color: var(--color-accent);
  }
  .pub__abstract p {
    margin-block-start: var(--space-3);
    max-inline-size: var(--width-measure);
    font-size: var(--step--1);
    color: var(--color-ink-2);
  }
  .pub__abstract summary::before {
    content: '+';
    font-family: var(--font-mono);
  }
  .pub__abstract[open] summary::before {
    content: '−';
  }
  /* compact variant: used in the home page and in related-work lists */
  .pub--compact {
    padding-block: var(--space-4);
  }
  .pub--compact .pub__grid {
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: var(--space-3);
  }
  .pub--compact .pub__year {
    font-size: var(--step-0);
  }
  @media (max-width: 48rem) {
    .pub__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2);
    }
    .pub__aside {
      flex-direction: row;
      gap: var(--space-3);
      align-items: baseline;
    }
  }
</style>
