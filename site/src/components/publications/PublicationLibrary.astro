---
import PublicationItem from './PublicationItem.astro';
import { t } from '../../i18n/ui';
import { PUB_TYPES, groupByYear, type Publication } from '../../utils/publications';
import type { Lang } from '../../utils/schema';

interface Props {
  pubs: Publication[];
  lang: Lang;
}
const { pubs, lang } = Astro.props;
const ui = t(lang);
const groups = groupByYear(pubs);
const types = PUB_TYPES.filter((ty) => pubs.some((p) => p.type === ty)).map((ty) => ({ ty, n: pubs.filter((p) => p.type === ty).length }));
const hasSelected = pubs.some((p) => p.selected);
const resultStrings = Object.fromEntries(Array.from({ length: pubs.length + 1 }, (_, n) => [n, ui.results(n)]));
---

<div class="library" data-library>
  <form class="library__controls" role="search" data-library-form>
    <div class="library__search">
      <label for="pub-search" class="label">{ui.search}</label>
      <input id="pub-search" type="search" placeholder={ui.searchPlaceholder} autocomplete="off" data-search-input />
    </div>
    {
      types.length > 1 && (
        <fieldset class="library__types">
          <legend class="label">{ui.filterType}</legend>
          <div class="library__chips">
            <button type="button" class="chip" aria-pressed="true" data-type-filter="all">
              {ui.allTypes}
            </button>
            {types.map(({ ty, n }) => (
              <button type="button" class="chip" aria-pressed="false" data-type-filter={ty}>
                {ui.types[ty]} <span class="ltr library__n">{n}</span>
              </button>
            ))}
          </div>
        </fieldset>
      )
    }
    {
      hasSelected && (
        <button type="button" class="chip library__selected" aria-pressed="false" data-selected-toggle>
          {ui.selectedOnly}
        </button>
      )
    }
    <p class="library__count" aria-live="polite" data-count data-strings={JSON.stringify(resultStrings)}>{ui.results(pubs.length)}</p>
  </form>

  {
    groups.map((g) => (
      <section class="year-group" data-year-group aria-labelledby={`year-${g.year ?? 'nd'}`}>
        <h2 class="year-group__year ltr" id={`year-${g.year ?? 'nd'}`}>
          {g.year ?? 'n.d.'}
        </h2>
        <div>
          {g.items.map((p) => (
            <PublicationItem pub={p} lang={lang} />
          ))}
        </div>
      </section>
    ))
  }
  <div class="library__nomatch" hidden data-nomatch>
    <p>{ui.noMatches}</p>
    <button type="button" class="button" data-clear>{ui.clearFilters}</button>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-library]');
  if (root) {
    const form = root.querySelector<HTMLFormElement>('[data-library-form]')!;
    const input = root.querySelector<HTMLInputElement>('[data-search-input]')!;
    const typeButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-type-filter]')];
    const selectedBtn = root.querySelector<HTMLButtonElement>('[data-selected-toggle]');
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const strings = JSON.parse(count.dataset.strings ?? '{}') as Record<string, string>;
    const items = [...root.querySelectorAll<HTMLElement>('[data-pub]')];
    const groups = [...root.querySelectorAll<HTMLElement>('[data-year-group]')];
    const noMatch = root.querySelector<HTMLElement>('[data-nomatch]')!;
    const fold = (s: string) => s.normalize('NFKD').replace(/[̀-ًͯ-ٟ]/g, '').toLowerCase().trim();
    let type = 'all';
    let selectedOnly = false;

    const update = () => {
      const terms = fold(input.value).split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const el of items) {
        const ok =
          (type === 'all' || el.dataset.type === type) &&
          (!selectedOnly || el.dataset.selected === 'true') &&
          terms.every((term) => (el.dataset.search ?? '').includes(term));
        el.hidden = !ok;
        if (ok) shown++;
      }
      for (const g of groups) g.hidden = !g.querySelector('[data-pub]:not([hidden])');
      count.textContent = strings[shown] ?? String(shown);
      noMatch.hidden = shown > 0;
    };

    form.addEventListener('submit', (e) => e.preventDefault());
    input.addEventListener('input', update);
    typeButtons.forEach((b) =>
      b.addEventListener('click', () => {
        type = b.dataset.typeFilter ?? 'all';
        typeButtons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        update();
      }),
    );
    selectedBtn?.addEventListener('click', () => {
      selectedOnly = !selectedOnly;
      selectedBtn.setAttribute('aria-pressed', String(selectedOnly));
      update();
    });
    root.querySelector('[data-clear]')?.addEventListener('click', () => {
      input.value = '';
      type = 'all';
      selectedOnly = false;
      typeButtons.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.typeFilter === 'all')));
      selectedBtn?.setAttribute('aria-pressed', 'false');
      update();
      input.focus();
    });
  }
</script>

<style>
  .library__controls {
    position: sticky;
    inset-block-start: var(--header-height);
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-4) var(--space-5);
    padding-block: var(--space-4);
    background: color-mix(in srgb, var(--color-paper) 94%, transparent);
    backdrop-filter: blur(14px);
    border-block-end: var(--border-hairline);
  }
  .library__search {
    display: grid;
    gap: var(--space-2);
    flex: 1 1 20rem;
  }
  input[type='search'] {
    inline-size: 100%;
    padding: 0.72em 1em;
    border: var(--border-hairline);
    border-radius: var(--radius-pill);
    background: var(--color-surface-1);
    font-family: var(--font-ui);
    font-size: var(--step-0);
    box-shadow: var(--shadow-float);
  }
  input[type='search']:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .library__types {
    border: 0;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2);
  }
  .library__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .library__n {
    opacity: 0.6;
    font-variant-numeric: tabular-nums;
  }
  .library__selected {
    margin-block-end: 0.15rem;
  }
  .library__count {
    margin-inline-start: auto;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--color-ink-3);
  }
  .year-group {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: var(--space-6);
    padding-block-start: var(--space-6);
  }
  .year-group__year {
    position: sticky;
    inset-block-start: calc(var(--header-height) + 8.5rem);
    align-self: start;
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    font-variant-numeric: lining-nums;
  }
  .library__nomatch {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    padding-block: var(--space-7);
    color: var(--color-ink-2);
  }
  @media (max-width: 48rem) {
    .library__controls {
      position: static;
    }
    .year-group {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    .year-group__year {
      position: static;
      font-size: var(--step-2);
      padding-block-end: var(--space-2);
      border-block-end: 2px solid var(--color-ink);
    }
  }
</style>
