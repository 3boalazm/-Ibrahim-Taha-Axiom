---
import { localePath, otherLang } from '../../utils/paths';
import { t } from '../../i18n/ui';
import type { Lang } from '../../utils/schema';

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const target = otherLang(lang);
const ui = t(lang);
// The link is named by the target language's own name ("العربية" / "English",
// spoken in that language via lang); the sentence is a description (title), so
// the visible text stays the accessible name (WCAG 2.5.3).
---

<a class="lang-switch" href={localePath(target, path)} hreflang={target} lang={target} title={ui.switchToLabel}>
  {t(target).languageName}
</a>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    padding: 0.55em 0.9em;
    border: var(--border-hairline);
    border-radius: var(--radius-pill);
    background: var(--color-surface-2);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
    line-height: 1.3;
  }
  .lang-switch:lang(ar) {
    font-family: var(--font-ar-sans);
  }
  .lang-switch:lang(en) {
    font-family: var(--font-sans);
  }
  .lang-switch:hover {
    background: var(--color-surface-2);
    color: var(--color-ink);
  }
</style>
