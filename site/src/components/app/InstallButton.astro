---
/**
 * "Install the app": hidden until AppInstall's script finds a way to install on this
 * device (the browser's own prompt, or written steps for Safari and Firefox). Without JS
 * it never shows, because nothing could happen on a click.
 */
import { t } from '../../i18n/ui';
import type { Lang } from '../../utils/schema';

interface Props {
  lang: Lang;
  class?: string;
}
const { lang, class: className } = Astro.props;
const ui = t(lang);
---

<button type="button" class:list={['app-install', className]} data-app-install hidden>
  <svg class="app-install__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path d="M8 2.5v7.25M4.75 6.75 8 10l3.25-3.25M3 13.25h10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <span>{ui.appInstall}</span>
</button>

<style>
  /* .button sets display, which would otherwise override the hidden attribute */
  .app-install[hidden] {
    display: none;
  }
  .app-install__icon {
    inline-size: 1.05em;
    block-size: 1.05em;
    flex: none;
  }
</style>
