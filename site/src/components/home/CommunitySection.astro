---
/**
 * Home: the community Ibrahim founded, one link per space.
 *
 * The links, their order and their kind come from profile.community (approved
 * data). The heading and the lead are the approved project entry
 * (projects.statistical-analysis-egypt); in Arabic the lead is its labelled
 * draft. Each tile names the platform and the kind of space in the page
 * language. Links open in the same tab, like every other external link on the
 * site.
 *
 * Icons: Simple Icons 16.36.0 (CC0-1.0, https://simpleicons.org). The marks
 * belong to their owners and only show where a link goes.
 */
import LangText from '../shared/LangText.astro';
import { profile, projects } from '../../utils/content';
import { localePath } from '../../utils/paths';
import type { CommunityKind, Lang } from '../../utils/schema';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ar = lang === 'ar';
const project = projects.find((p) => p.id === 'statistical-analysis-egypt');

const ICONS = {
  facebook: 'M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z',
  telegram: 'M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z',
  whatsapp: 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z',
};
const KINDS: Record<CommunityKind, { en: string; ar: string; icon: keyof typeof ICONS }> = {
  'facebook-page': { en: 'Facebook page', ar: 'صفحة فيسبوك', icon: 'facebook' },
  'facebook-group': { en: 'Facebook group', ar: 'مجموعة فيسبوك', icon: 'facebook' },
  'telegram-group': { en: 'Telegram group', ar: 'مجموعة تيليجرام', icon: 'telegram' },
  'whatsapp-group': { en: 'WhatsApp group', ar: 'مجموعة واتساب', icon: 'whatsapp' },
};
const links = profile.community.map((c) => ({
  url: c.url,
  kind: c.kind,
  name: KINDS[c.kind][lang],
  icon: ICONS[KINDS[c.kind].icon],
  host: new URL(c.url).hostname.replace(/^www\./, ''),
}));
---

{
  links.length > 0 && (
    <section class="community container" id="community" aria-labelledby="community-title">
      <div class="community__head" data-reveal>
        <p class="kicker">{ar ? 'المجتمع' : 'Community'}</p>
        <h2 id="community-title" class="community__title">
          {project ? <LangText value={project.title} lang={lang} /> : ar ? 'مجتمع الإحصاء' : 'Statistics community'}
        </h2>
        {project?.summary && <LangText as="p" class="community__lead" value={project.summary} lang={lang} />}
        {project && (
          <a class="community__more" href={`${localePath(lang, '/projects/')}#${project.id}`}>
            {ar ? 'عن المشروع' : 'About the project'}
          </a>
        )}
      </div>
      <ul class="community__links" role="list" data-stagger>
        {links.map((c) => (
          <li>
            <a class="community__link" href={c.url} rel="noopener" data-kind={c.kind}>
              <svg class="community__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d={c.icon} />
              </svg>
              <span class="community__name">{c.name}</span>{' '}
              <span class="community__host ltr">{c.host}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .community {
    display: grid;
    gap: var(--space-4);
    padding-block: clamp(var(--space-6), 5vw, var(--space-8));
  }
  .community__head {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    max-inline-size: 46rem;
  }
  .community__title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 400;
    line-height: 1.1;
  }
  .community__head :global(.community__lead) {
    color: var(--color-ink-2);
    line-height: 1.7;
  }
  .community__more {
    font-family: var(--font-ui);
    font-size: var(--step--1);
  }
  .community__links {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    margin: 0;
    padding: 0;
  }
  .community__link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas: 'icon name' 'icon host';
    gap: 0.1rem var(--space-3);
    align-items: center;
    block-size: 100%;
    min-block-size: 3.5rem;
    padding: var(--space-3) var(--space-4);
    border: var(--border-hairline);
    border-radius: var(--radius-4);
    background: var(--color-surface-1);
    color: var(--color-ink);
    text-decoration: none;
    transition: border-color var(--dur-2) var(--ease-out);
  }
  .community__link:hover {
    border-color: var(--color-accent);
  }
  .community__link:hover .community__name {
    color: var(--color-accent);
  }
  .community__link:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }
  .community__icon {
    grid-area: icon;
    inline-size: 1.5rem;
    block-size: 1.5rem;
    fill: currentColor;
    color: var(--color-accent);
  }
  .community__name {
    grid-area: name;
    font-family: var(--font-serif);
    font-size: var(--step-0);
    line-height: 1.3;
  }
  .community__host {
    grid-area: host;
    /* the host reads left to right; keep it under the name at the page's start edge */
    justify-self: start;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--color-ink-3);
  }
  /* four spaces: one column on phones, two by two, then one row */
  @media (min-width: 34rem) {
    .community__links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .community__links {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .community__link {
      transition: none;
    }
  }
</style>
