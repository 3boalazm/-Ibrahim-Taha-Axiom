---
/**
 * Research discovery, kept light: one compact tile per approved research area
 * (its number, title and count of linked publications, from verified manifest
 * relationships) and the knowledge-graph teaser. Images, summaries, publication
 * previews and projects live on /research/, /publications/ and /projects/.
 */
import { arNoun } from '../../lib/text.mjs';
import LangText from '../shared/LangText.astro';
import { methods, projects, researchAreas } from '../../utils/content';
import { getPublication, publications } from '../../utils/publications';
import { publicationsOfArea, relations } from '../../utils/relations';
import { localePath } from '../../utils/paths';
import { t } from '../../i18n/ui';
import type { Lang } from '../../utils/schema';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const ar = lang === 'ar';
const research = localePath(lang, '/research/');
const cards = researchAreas.map((a, i) => ({
  a,
  number: String(i + 1).padStart(2, '0'),
  n: publicationsOfArea(a.id).filter((k) => getPublication(k)).length,
}));
const linkedPubs = new Set(relations.filter((r) => r.from.kind === 'publication').map((r) => r.from.id)).size;
const counts = [
  { n: researchAreas.length, label: ar ? arNoun(researchAreas.length, { one: 'مجال', two: 'مجالان', few: 'مجالات', many: 'مجالًا' }) : researchAreas.length === 1 ? 'area' : 'areas' },
  { n: methods.length, label: ar ? arNoun(methods.length, { one: 'أسلوب', two: 'أسلوبان', few: 'أساليب', many: 'أسلوبًا' }) : methods.length === 1 ? 'method' : 'methods' },
  { n: linkedPubs, label: ar ? arNoun(linkedPubs, { one: 'منشور مرتبط', two: 'منشوران مرتبطان', few: 'منشورات مرتبطة', many: 'منشورًا مرتبطًا' }) : linkedPubs === 1 ? 'linked publication' : 'linked publications' },
  { n: projects.length, label: ar ? arNoun(projects.length, { one: 'مشروع', two: 'مشروعان', few: 'مشروعات', many: 'مشروعًا' }) : projects.length === 1 ? 'project' : 'projects' },
  { n: relations.length, label: ar ? arNoun(relations.length, { one: 'علاقة موثّقة', two: 'علاقتان موثّقتان', few: 'علاقات موثّقة', many: 'علاقةً موثّقةً' }) : relations.length === 1 ? 'verified link' : 'verified links' },
];
---

<section class="disc container" aria-labelledby="disc-title">
  <div class="disc__head" data-reveal>
    <div>
      <p class="kicker">{ar ? 'البحث' : 'Research'}</p>
      <h2 id="disc-title" class="disc__title">{ar ? 'ستة مجالات، وكل رابطٍ بدليله' : 'Six areas, every link with its evidence'}</h2>
    </div>
    <a class="button" href={research}>
      {ar ? 'كل المجالات' : 'All research areas'}
      <span class="button__arrow icon-flip" aria-hidden="true">→</span>
    </a>
  </div>

  <ol class="disc__grid" role="list" data-stagger>
    {
      cards.map(({ a, number, n }) => (
        <li>
          <a class="dcard" href={`${research}#${a.id}`}>
            <span class="dcard__num ltr" aria-hidden="true">{number}</span>
            <span class="dcard__title">
              <LangText value={a.title} lang={lang} />
            </span>{' '}
            <span class="dcard__meta">{n ? ui.results(n) : ar ? 'لا منشورات مرتبطة بعد' : 'No linked publications yet'}</span>
          </a>
        </li>
      ))
    }
  </ol>

  <a class="gteaser" href={`${research}#knowledge-graph`}>
    <span class="gteaser__kicker">{ar ? 'خريطة الترابط' : 'Knowledge graph'}</span>
    <span class="gteaser__title">{ar ? 'كيف تتصل المجالات بالمنشورات والمشروعات' : 'How areas, publications and projects connect'}</span>
    <span class="gteaser__counts">
      {
        counts.map((c) => (
          <span>
            <b class="ltr">{c.n}</b> {c.label}
          </span>
        ))
      }
    </span>
    <svg class="gteaser__art" viewBox="0 0 220 90" aria-hidden="true">
      {[14, 38, 62].map((y) => <circle cx="20" cy={y + 6} r="5" />)}
      {[8, 23, 38, 53, 68, 83].map((y) => <rect x="102" y={y - 3} width="16" height="6" rx="2" />)}
      {[22, 50, 74].map((y) => <circle cx="200" cy={y} r="5" />)}
      <path d="M25 20C60 20 65 5 102 5M25 20C60 20 65 35 102 35M25 44C60 44 65 50 102 50M25 68C60 68 65 80 102 80M118 20C150 20 160 22 195 22M118 50C150 50 160 50 195 50M118 65C150 65 160 74 195 74" />
    </svg>
  </a>
  {publications.length === 0 && <p>{ui.awaitingReview}</p>}
</section>

<style>
  .disc {
    display: grid;
    gap: var(--space-5);
    padding-block: clamp(var(--space-6), 5vw, var(--space-8));
  }
  .disc__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .disc__title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 400;
    line-height: 1.1;
  }
  .disc__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
  }
  .dcard {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas: 'num title' 'num meta';
    gap: 0.2rem var(--space-3);
    align-items: baseline;
    block-size: 100%;
    padding: var(--space-4);
    border: var(--border-hairline);
    border-radius: var(--radius-4);
    background: var(--color-surface-1);
    color: var(--color-ink);
    text-decoration: none;
    transition: border-color var(--dur-2) var(--ease-out);
  }
  .dcard:hover {
    border-color: var(--color-accent);
  }
  .dcard:hover .dcard__title {
    text-decoration: underline;
  }
  .dcard:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }
  .dcard__num {
    grid-area: num;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--color-brass-ink);
  }
  .dcard__title {
    grid-area: title;
    font-family: var(--font-serif);
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.25;
  }
  .dcard__meta {
    grid-area: meta;
    font-family: var(--font-ui);
    font-size: var(--step--2);
    color: var(--color-brass-ink);
  }
  .gteaser {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
    border: var(--border-hairline);
    border-radius: var(--radius-4);
    background: var(--color-accent-soft);
    color: var(--color-ink);
    text-decoration: none;
    overflow: hidden;
  }
  .gteaser:hover {
    border-color: var(--color-accent);
  }
  .gteaser:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }
  .gteaser__kicker {
    font-family: var(--font-ui);
    font-size: var(--step--2);
    color: var(--color-accent-strong);
  }
  .gteaser__title {
    max-inline-size: 22rem;
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.3;
  }
  .gteaser__counts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    font-family: var(--font-ui);
    font-size: var(--step--2);
    color: var(--color-ink-2);
  }
  .gteaser__counts b {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 400;
    color: var(--color-ink);
  }
  .gteaser__art {
    position: absolute;
    inset-inline-end: var(--space-4);
    inset-block-start: var(--space-4);
    inline-size: 9rem;
    opacity: 0.55;
  }
  :global([dir='rtl']) .gteaser__art {
    transform: scaleX(-1);
  }
  .gteaser__art circle {
    fill: var(--color-accent);
  }
  .gteaser__art rect {
    fill: var(--color-ink-3);
  }
  .gteaser__art path {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1;
  }
  @media (max-width: 56rem) {
    .gteaser__art {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dcard {
      transition: none;
    }
  }
</style>
